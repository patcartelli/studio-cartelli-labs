{
  "extends": "astro/tsconfigs/strict",
  // Scoped explicitly instead of "**/*" so a new top-level directory cannot
  // silently enter `astro check`'s scope. Add new roots here deliberately.
  "include": [
    ".astro/**/*.d.ts",
    "src/**/*",
    "tests/**/*",
    "scripts/**/*",
    "astro.config.mjs",
    "playwright.config.ts"
  ],
  "exclude": ["dist", "node_modules"],
  "compilerOptions": {
    // @webgpu/types is here for STC-320's WGSL study (src/lib/frame-diff-gpu.ts).
    // The DOM lib has no WebGPU declarations, so without it `navigator.gpu`,
    // GPUDevice and every GPU* type are errors — and an unchecked GPU
    // pipeline is exactly the code you cannot afford to hand-verify, since
    // none of it runs at build time.
    "types": ["@cloudflare/workers-types", "@webgpu/types"]
  }
}

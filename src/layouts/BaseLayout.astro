---
// src/layouts/BaseLayout.astro
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  ogTitle?: string;
  navWideMargin?: boolean;
}

const {
  title,
  description = 'Studio Cartelli is the design practice of Patrick Cartelli.',
  noindex = false,
  ogTitle,
  navWideMargin = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL('/og-image.jpg', Astro.site);
const resolvedOgTitle = ogTitle ?? title;
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Theme init + JS flag: runs synchronously before paint to prevent flash -->
    <script is:inline>
      (function () {
        document.documentElement.classList.add('js');
        var stored;
        try { stored = localStorage.getItem('theme'); } catch (e) {}
        if (stored === 'dark') {
          document.documentElement.dataset.theme = 'dark';
        } else if (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches) {
          document.documentElement.dataset.theme = 'dark';
        }
      })();
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title === 'Studio Cartelli' ? title : `${title} — Studio Cartelli`}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:title" content={resolvedOgTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Studio Cartelli" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={resolvedOgTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {/* Polymath preloads, mirroring the main site's BaseLayout. These are
       URLs only — no font binary lives in this repo (see the FONT FACES
       note in src/styles/global.css for the licensing and routing
       rationale).

       Root-absolute on purpose: /fonts/* falls outside this Worker's
       studiocartelli.com/lab* route, so the zone serves it from the main
       studio-cartelli Worker. Do not prefix these with the /lab base.

       `crossorigin` is required even though this is same-origin in
       production: font fetches are always CORS-mode, and a preload
       without it is treated as a different request than the one
       @font-face makes, causing the file to be downloaded twice.

       Only the three faces used above the fold are preloaded (matching
       the main site); the italic and bold-italic faces load on demand.

       In local dev these 404 harmlessly — there is no main site behind
       the dev server. The @font-face rules carry a /lab/fonts/ fallback
       for that case. */}
    <link rel="preload" href="/fonts/PolymathDisp-Semibold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/PolymathText-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/PolymathText-Bold.woff2" as="font" type="font/woff2" crossorigin />

    <slot name="head" />

    {/* Cloudflare Web Analytics: the main site's beacon token is scoped to
       its own zone and deliberately not reused here. Add your own token
       (Cloudflare dashboard → Analytics → Web Analytics) if you want
       analytics on this deploy. */}
  </head>
  <body>
    <a href="#main-content" class="skip-to-content">Skip to content</a>
    <Nav wideMargin={navWideMargin} />
    <main id="main-content">
      <slot />
    </main>
    {/* navWideMargin is the homepage flag — it's set true only by the
       homepage and now governs the footer grid too (STC-159), so future
       callers should not set one without the other. */}
    <Footer wideMargin={navWideMargin} />
  </body>
  <script>
    import '../scripts/motion.ts';
    import Lenis from 'lenis';

    const lenis = new Lenis();

    function raf(time: number) {
      lenis.raf(time);
      requestAnimationFrame(raf);
    }

    requestAnimationFrame(raf);
  </script>
  <style is:global>
    /* Any layout-level global overrides go here */
    main {
      flex: 1; /* fills space between nav and footer in flex-column body */
    }

    .skip-to-content {
      position: absolute;
      left: -9999px;
      top: var(--space-sm);
      padding: var(--space-xs) var(--space-sm);
      background: var(--color-on-surface);
      color: var(--color-surface);
      font-size: var(--text-body-medium);
      z-index: 9999;
    }

    .skip-to-content:focus {
      left: var(--space-sm);
    }
  </style>
</html>

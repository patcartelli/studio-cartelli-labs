    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }
  .network__changelog-date {
    font-size: var(--text-body-medium);
    color: var(--color-on-surface-dimmed);
  }
  .network__changelog-items {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }
  .network__changelog-item {
    display: flex;
    align-items: baseline;
    gap: var(--space-xs);
    font-size: var(--text-body-medium);
    color: var(--color-on-surface);
  }
  .network__changelog-label {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 10px;
    padding: 1px 6px;
    border-radius: 3px;
    border: 1px solid;
  }
  .network__changelog-label--feature {
    color: #166534;
    background: #f0fdf4;
    border-color: #bbf7d0;
  }
  .network__changelog-label--bugfix {
    color: #991b1b;
    background: #fff1f2;
    border-color: #fecdd3;
  }
  .network__changelog-label--improvement {
    color: #1e40af;
    background: #eff6ff;
    border-color: #bfdbfe;
  }
  :root[data-theme="dark"] .network__changelog-label--feature {
    color: #86efac;
    background: rgba(22, 101, 52, 0.3);
    border-color: rgba(22, 101, 52, 0.5);
  }
  :root[data-theme="dark"] .network__changelog-label--bugfix {
    color: #fca5a5;
    background: rgba(153, 27, 27, 0.3);
    border-color: rgba(153, 27, 27, 0.5);
  }
  :root[data-theme="dark"] .network__changelog-label--improvement {
    color: #93c5fd;
    background: rgba(30, 64, 175, 0.3);
    border-color: rgba(30, 64, 175, 0.5);
  }

  /* ── Mobile ── */
  @media (max-width: 480px) {
    /* On a phone there is no room to float a key over the graph: it drops
       below the canvas as an ordinary wrapping row. */
    .network__legend.network__overlay {
      position: static;
      flex-direction: row;
      flex-wrap: wrap;
      gap: var(--space-2xs) var(--space-sm);
      max-width: none;
      margin-top: var(--space-xs);
      border: 0;
      background: none;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
    /* The period control takes the top row; the panel drops under it. */
    .network__overlay--tl {
      top: 52px;
    }
    .network__panel {
      width: 180px;
    }
    /* View toggles join the key below the canvas rather than sit on top of it. */
    .network__tools.network__overlay {
      position: static;
      margin-top: var(--space-xs);
      padding: 0;
      border: 0;
      background: none;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }
</style>

<script>
  import * as d3 from 'd3';
  import { assignGenres } from '../lib/network-genre';
  // GENRE_FAMILIES is used in the frontmatter to build the legend, not here.
  import { genreFamilyForTags, genreFamilySlug, type GenreFamily } from '../lib/genre-families';

  function initNetwork() {
    const scriptTag = document.getElementById('graph-data');
    if (!scriptTag) {
      // No data — page is in error state, nothing to render
      document.querySelector('.network__loading')?.remove();
      const canvas = document.getElementById('network-container');
      if (canvas) canvas.style.display = 'none';
      return;
    }

    const graphData = JSON.parse(scriptTag.textContent ?? '{"nodes":[],"links":[]}') as {
      nodes: Array<{ id: string; name: string; playcount: number; url: string }>;
      links: Array<{ source: string; target: string; sharedTags: string[]; similarity: number; influenceDirection?: string }>;
    };

    const tagsScriptTag = document.getElementById('all-tags-data');
    const allTags: string[] = tagsScriptTag
      ? (JSON.parse(tagsScriptTag.textContent ?? '[]') as string[])
      : [];

    const nodeTagsScript = document.getElementById('node-tags-data');
    const nodeTagsRaw: Record<string, string[]> = nodeTagsScript
      ? (JSON.parse(nodeTagsScript.textContent ?? '{}') as Record<string, string[]>)
      : {};

    // STC-334: formation year per artist (Wikidata P571), keyed by node id.
    // Sparse by design -- P571 is an org/group property, so solo artists
    // won't have an entry. Lets a viewer read "who came first" for any pair
    // just by hovering each node, independent of an explicit P737 influence
    // claim existing between them.
    const nodeChronologyScript = document.getElementById('node-chronology-data');
    const nodeChronology: Record<string, number> = nodeChronologyScript
      ? (JSON.parse(nodeChronologyScript.textContent ?? '{}') as Record<string, number>)
      : {};

    // Outside influencers: P737 targets that aren't in this period's top 100,
    // kept as tethered ghost nodes so the influence layer isn't empty when no
    // two listened-to artists are linked. See src/lib/network-ghosts.ts.
    const ghostScript = document.getElementById('ghost-data');
    const ghostRaw: {
      nodes: Array<{ id: string; name: string; url: string; influenced: string[] }>;
      links: Array<{ source: string; target: string }>;
    } = ghostScript
      ? JSON.parse(ghostScript.textContent ?? '{"nodes":[],"links":[]}')
      : { nodes: [], links: [] };

    const container = document.getElementById('network-container');
    if (!container) return;

    // Remove loading message once we start rendering
    container.querySelector('.network__loading')?.remove();

    const width = container.clientWidth || 800;
    const height = Math.max(600, Math.floor(window.innerHeight * 0.72));

    // Node radius: square-root scale so area is proportional to play count
    const maxPlaycount = d3.max(graphData.nodes, (d) => d.playcount) ?? 1;
    const radiusScale = d3.scaleSqrt().domain([0, maxPlaycount]).range([2.5, 17]);

    // XSS prevention: escape artist names and tags before inserting into tooltip HTML
    function escapeHtml(str: string): string {
      return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    const svg = d3
      .select(container)
      .append('svg')
      .attr('width', width)
      .attr('height', height)
      .attr('aria-hidden', 'true')
      .attr('overflow', 'hidden')
      .style('overflow', 'hidden')
      .style('display', 'block');

    // Zoom layer
    const g = svg.append('g');
    const zoomBehavior = d3
      .zoom<SVGSVGElement, unknown>()
      .scaleExtent([0.1, 4])
      .on('zoom', (event) => g.attr('transform', event.transform));
    svg.call(zoomBehavior).on('dblclick.zoom', null);

    // Arrowhead marker for influence edges (VIS-01)
    // markerUnits=userSpaceOnUse prevents scaling by stroke-width (which is 1px — would make marker invisible)
    svg.append('defs')
      .append('marker')
      .attr('id', 'arrowhead')
      .attr('markerWidth', 6)
      .attr('markerHeight', 6)
      .attr('refX', 5)
      .attr('refY', 3)
      .attr('orient', 'auto')
      .attr('markerUnits', 'userSpaceOnUse')
      .append('polygon')
      .attr('points', '0 0, 6 3, 0 6')
      .attr('fill', 'var(--color-on-surface)')
      .attr('fill-opacity', 0.7);

    // Deep-copy nodes and links so D3 can mutate them safely.
    // Scatter the initial positions across a virtual canvas much larger
    // than the viewport so the graph starts out genuinely pannable rather
    // than all packed into the visible box. Use an absolute minimum so
    // mobile (where width can be ~375px) still gets a wide scatter.
    const spreadW = Math.max(width * 3, 1800);
    const spreadH = Math.max(height * 3, 1800);
    const nodes = graphData.nodes.map((n) => ({
      ...n,
      x: (Math.random() - 0.5) * spreadW + width / 2,
      y: (Math.random() - 0.5) * spreadH + height / 2,
    }));
    const links = graphData.links.map((l) => ({ ...l }));

    // Ghost nodes join the force simulation (they need positions) but nothing
    // that is keyed off `nodes` -- genre poles, family colour, filters, counts.
    const GHOST_RADIUS = 5;
    const ghostNodes = ghostRaw.nodes.map((n) => ({
      ...n,
      x: (Math.random() - 0.5) * spreadW + width / 2,
      y: (Math.random() - 0.5) * spreadH + height / 2,
    }));
    // Source is the influencer (ghost), target the influenced artist, so the
    // arrow runs source -> target with no direction swap.
    const ghostLinks = ghostRaw.links.map((l) => ({ ...l, type: 'ghost-influence' as const }));
    const ghostTargets = new Map<string, string[]>();
    ghostRaw.links.forEach((l) => {
      ghostTargets.set(l.source, [...(ghostTargets.get(l.source) ?? []), l.target]);
    });

    // --- Node tag set (for genre/tag filtering) ---
    const nodeTagSet = new Map<string, Set<string>>();
    nodes.forEach((n) => {
      const tags = nodeTagsRaw[n.id] ?? [];
      nodeTagSet.set(n.id, new Set(tags));
    });

    // --- State ---
    const state = {
      groupByGenre: false,
      fullscreen: false,
      searchTerm: '',
      selectedTag: '',
      selectedFamily: '',
      similarityThreshold: 0,
    };

    const btnGenre = document.getElementById('ctrl-genre') as HTMLButtonElement | null;
    const btnFullscreen = document.getElementById('ctrl-fullscreen') as HTMLButtonElement | null;

    // MOB-03: Hide fullscreen button when Fullscreen API is not supported (e.g. iOS Safari)
    if (btnFullscreen && !document.fullscreenEnabled) {
      btnFullscreen.hidden = true;
    }

    // --- Genre assignment ---
    // A node's own tag list (nodeTagsRaw[n.id], from Last.fm's
    // artist.getTopTags and already ranked by relevance) is the ground
    // truth for "this artist's genre" -- not whatever it happens to share
    // with a directly-connected neighbor. The previous version derived
    // genre purely from edge-level sharedTags, so a well-tagged artist
    // still landed in 'other' whenever none of its graph edges happened to
    // carry a shared tag first (e.g. it was only connected via
    // similarity/influence edges, or lost the tag to a neighbor) -- STC-340.
    const { primary: nodeGenre, secondary: nodeGenre2 } = assignGenres(
      nodes.map((n) => n.id),
      nodeTagsRaw
    );

    // Colour family per node (STC-339). nodeGenre above is the artist's own
    // top tag, which is what the genre poles cluster on; the family is the
    // broader bucket that tag rolls up into, and is what carries colour.
    // Eight families plus an uncoloured 'other' -- see src/lib/genre-families.ts.
    const nodeFamily = new Map<string, GenreFamily>();
    nodes.forEach((n) => nodeFamily.set(n.id, genreFamilyForTags(nodeTagsRaw[n.id] ?? [])));

    const familyFill = (id: string) =>
      `var(--genre-${genreFamilySlug(nodeFamily.get(id) ?? 'other')})`;

    // Fill in the legend's per-family node counts. The labels and swatches are
    // server-rendered, so the legend is already readable if this never runs.
    const familyCounts = new Map<string, number>();
    nodeFamily.forEach((family) => {
      const slug = genreFamilySlug(family);
      familyCounts.set(slug, (familyCounts.get(slug) ?? 0) + 1);
    });
    document.querySelectorAll<HTMLElement>('.network__legend-count').forEach((el) => {
      const slug = el.dataset.genreFamily;
      if (!slug) return;
      const count = familyCounts.get(slug) ?? 0;
      el.textContent = String(count);
      // A family with no artists can't isolate anything; don't offer it.
      if (count === 0) el.closest('li')?.setAttribute('hidden', '');
    });

    // --- Interactive legend (STC-339) ---
    // Clicking a family isolates it; clicking the pressed one clears. One
    // family at a time, so the key doubles as a way to answer "which nodes are
    // these?" without relying on telling two hues apart by eye.
    const legendButtons = Array.from(
      document.querySelectorAll<HTMLButtonElement>('.network__legend-item')
    );
    legendButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const slug = btn.dataset.genreFamily ?? '';
        state.selectedFamily = state.selectedFamily === slug ? '' : slug;
        legendButtons.forEach((b) => {
          b.setAttribute(
            'aria-pressed',
            String(b.dataset.genreFamily === state.selectedFamily && state.selectedFamily !== '')
          );
        });
        applyFilters();
      });
    });

    // --- Genre nodes and links ---
    // Cap the number of poles. The own-top-tag genres assignGenres returns are
    // far more granular than the edge-derived ones they replaced, so an
    // uncapped list rings the canvas with dozens of single-member poles; the
    // long tail clusters under 'other' instead.
    const MAX_GENRE_POLES = 12;
    const genreCounts = new Map<string, number>();
    nodeGenre.forEach((genre) => genreCounts.set(genre, (genreCounts.get(genre) ?? 0) + 1));
    const topGenres = new Set(
      Array.from(genreCounts.entries())
        .filter(([genre]) => genre !== 'other')
        .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
        .slice(0, MAX_GENRE_POLES)
        .map(([genre]) => genre)
    );
    nodeGenre.forEach((genre, id) => {
      if (!topGenres.has(genre)) nodeGenre.set(id, 'other');
    });
    nodeGenre2.forEach((genre, id) => {
      if (!topGenres.has(genre)) nodeGenre2.delete(id);
    });

    const genres = Array.from(new Set(nodeGenre.values()));
    const poleRadius = Math.min(width, height) * 0.35;
    const cx = width / 2;
    const cy = height / 2;

    // Radius sized to contain the genre label (10px font, ~6px/char)
    const genreNodeRadius = (name: string) => Math.max(24, Math.round(name.length * 3.2 + 8));

    type GenreNodeDatum = {
      id: string;
      name: string;
      type: 'genre';
      radius: number;
      x: number;
      y: number;
      fx: number | null;
      fy: number | null;
    } & d3.SimulationNodeDatum;

    const genreNodes: GenreNodeDatum[] = genres.map((genre, i) => {
      const angle = (2 * Math.PI * i) / genres.length;
      return {
        id: `genre::${genre}`,
        name: genre,
        type: 'genre' as const,
        radius: genreNodeRadius(genre),
        x: cx + poleRadius * Math.cos(angle),
        y: cy + poleRadius * Math.sin(angle),
        fx: null,
        fy: null,
      };
    });

    const genreLinks = nodes.map((n) => ({
      source: n.id,
      target: `genre::${nodeGenre.get(n.id) ?? 'other'}`,
      type: 'genre' as const,
    }));

    // Secondary genre links — only include entries where the secondary genre
    // is also a primary genre for some node (i.e. exists in genreNodes).
    const validGenreIds = new Set(genres);
    const genreLinks2 = nodes
      .filter((n) => {
        const g2 = nodeGenre2.get(n.id);
        return g2 !== undefined && validGenreIds.has(g2);
      })
      .map((n) => ({
        source: n.id,
        target: `genre::${nodeGenre2.get(n.id)!}`,
        type: 'genre2' as const,
      }));

    // Link geometry by edge kind. Artist edges are driven by similarity;
    // genre links pull a node toward its pole; a ghost link tethers an outside
    // influencer close to the artist it influenced.
    const linkDistance = (d: unknown) => {
      const l = d as { type?: string; similarity?: number };
      if (l.type === 'genre') return 80;
      if (l.type === 'genre2') return 140;
      if (l.type === 'ghost-influence') return 70;
      const sim = l.similarity ?? 0;
      return sim > 0 ? 30 + (1 - sim) * 160 : 200;
    };
    const linkStrength = (d: unknown) => {
      const l = d as { type?: string; similarity?: number };
      if (l.type === 'genre') return 0.3;
      if (l.type === 'genre2') return 0.08;
      if (l.type === 'ghost-influence') return 0.5;
      const sim = l.similarity ?? 0;
      return sim > 0 ? sim * 0.6 : 0.05;
    };

    // Force simulation
    const simulation = d3
      .forceSimulation([...nodes, ...ghostNodes] as d3.SimulationNodeDatum[])
      .force(
        'link',
        d3
          .forceLink([...links, ...ghostLinks])
          .id((d) => (d as { id: string }).id)
          .distance(linkDistance)
          .strength(linkStrength)
      )
      .force('charge', d3.forceManyBody().strength(-400).distanceMax(1200))
      // Very weak gravity toward the canvas center — just enough to prevent
      // the graph from drifting away forever, but soft enough that nodes
      // genuinely live outside the viewport on first load.
      .force('x', d3.forceX(width / 2).strength(0.012))
      .force('y', d3.forceY(height / 2).strength(0.012))
      .force(
        'collision',
        d3.forceCollide().radius((d) => {
          const n = d as { playcount?: number; type?: string; radius?: number };
          if (n.type === 'genre') return (n.radius ?? 24) + 3;
          return radiusScale(n.playcount ?? 0) + 3;
        })
      );

    // Pre-run the simulation synchronously so the layout has already
    // stabilized before the first paint. This lets us compute a real
    // bounding box and zoom-to-fit below — without this, we'd be
    // rendering during a still-converging layout and the graph would
    // look confined to the viewport.
    simulation.stop();
    for (let i = 0; i < 300; i++) simulation.tick();

    // --- Edge and label styling ---
    // Three kinds of artist edge, drawn very differently:
    //   influence  -- Wikidata P737, the rarest and most meaningful: ink, bold.
    //   similarity -- Last.fm match score, so weight and strength scale with it
    //                 and the line takes the genre colour of the artist it
    //                 starts from.
    //   tag-only   -- shares a tag and nothing else. These are ~80% of the links
    //                 and, drawn, bury everything else in a hairball, so they are
    //                 not drawn at all. They still pull on the force layout, which
    //                 is what keeps same-genre artists clustered.
    type StyledLink = { source: any; target: any; similarity?: number; influenceDirection?: string };
    const isInfluenceEdge = (l: StyledLink) => !!l.influenceDirection;
    const isTagOnlyEdge = (l: StyledLink) => !((l.similarity ?? 0) > 0) && !l.influenceDirection;
    const edgeSimilarity = (l: StyledLink) => l.similarity ?? 0;
    const edgeStroke = (l: StyledLink) =>
      isInfluenceEdge(l) ? 'var(--color-on-surface)' : familyFill((l.source as { id: string }).id);
    const edgeWidth = (l: StyledLink) =>
      isInfluenceEdge(l) ? 1.5 : isTagOnlyEdge(l) ? 0 : 0.6 + 2.4 * edgeSimilarity(l);
    const edgeOpacity = (l: StyledLink) =>
      isInfluenceEdge(l) ? 0.85 : isTagOnlyEdge(l) ? 0 : 0.2 + 0.6 * edgeSimilarity(l);

    // Only the most-played artists carry a visible label; hover names the rest.
    // A search hit is labelled too, so searching actually points at something.
    const TOP_LABEL_COUNT = 18;
    const playRank = new Map<string, number>();
    [...nodes].sort((a, b) => b.playcount - a.playcount).forEach((n, i) => playRank.set(n.id, i));
    const labelOpacity = (d: { id: string; name: string }) => {
      const searched =
        state.searchTerm !== '' && d.name.toLowerCase().includes(state.searchTerm.toLowerCase());
      return searched || (playRank.get(d.id) ?? Infinity) < TOP_LABEL_COUNT ? 0.85 : 0;
    };

    // Links
    const link = g
      .append('g')
      .selectAll('line')
      .data(links)
      .join('line')
      .attr('stroke', (d: any) => edgeStroke(d))
      .attr('stroke-width', (d: any) => edgeWidth(d))
      .attr('stroke-opacity', (d: any) => edgeOpacity(d))
      .attr('marker-end', (d: any) => {
        const ld = d as { influenceDirection?: string };
        return ld.influenceDirection ? 'url(#arrowhead)' : null;
      });

    // Hit-area lines for edge hover detection (transparent wide stroke)
    const linkHit = g.append('g')
      .selectAll<SVGLineElement, typeof links[0]>('line')
      .data(links)
      .join('line')
      .attr('stroke', 'transparent')
      .attr('stroke-width', 8)
      .attr('cursor', 'pointer')
      // An undrawn (tag-only) edge must not be hoverable either.
      .style('pointer-events', (d: any) => (edgeOpacity(d) === 0 ? 'none' : 'stroke'));

    // Ghost influence edges: influencer -> influenced, dotted and always
    // arrowed. Added before the node layers so they draw underneath.
    const ghostLink = g
      .append('g')
      .attr('class', 'network__ghost-links')
      .selectAll<SVGLineElement, typeof ghostLinks[0]>('line')
      .data(ghostLinks)
      .join('line')
      .attr('class', 'network__ghost-edge')
      // On-surface rather than the --color-border the artist edges use: those
      // sit in a dense hairball and a dotted border-grey tether vanishes in it.
      .attr('stroke', 'var(--color-on-surface)')
      // Literal, not FULL_EDGE_OPACITY: that const is declared further down,
      // and this runs first.
      .attr('stroke-opacity', 0.5)
      .attr('stroke-width', 1)
      .attr('stroke-dasharray', '2,3')
      .attr('marker-end', 'url(#arrowhead)');

    // Genre links (hidden until genre toggle is ON)
    const genreLinkGroup = g.append('g')
      .attr('stroke', 'var(--color-border)')
      .attr('stroke-opacity', 0.3)
      .style('display', 'none');
    const genreLinkSel = genreLinkGroup
      .selectAll<SVGLineElement, typeof genreLinks[0]>('line')
      .data(genreLinks)
      .join('line')
      .attr('stroke-width', 1)
      .attr('stroke-dasharray', '3,3');

    // Secondary genre links (hidden until genre toggle is ON)
    const genreLink2Group = g.append('g')
      .attr('stroke', 'var(--color-border)')
      .attr('stroke-opacity', 0.15)
      .style('display', 'none');
    const genreLink2Sel = genreLink2Group
      .selectAll<SVGLineElement, typeof genreLinks2[0]>('line')
      .data(genreLinks2)
      .join('line')
      .attr('stroke-width', 1)
      .attr('stroke-dasharray', '6,4');

    // Nodes
    type NodeDatum = typeof nodes[0] & d3.SimulationNodeDatum;
    const node = g
      .append('g')
      .selectAll<SVGCircleElement, NodeDatum>('circle')
      .data(nodes as NodeDatum[])
      .join('circle')
      .attr('r', (d) => radiusScale(d.playcount))
      .attr('fill', (d) => familyFill(d.id))
      // Matches FULL_NODE_OPACITY, which applyFilters resets to on first run.
      .attr('fill-opacity', 0.95)
      // Keyline in the page colour so a node stays separate from the lines under it.
      .attr('stroke', 'var(--color-surface)')
      .attr('stroke-width', 1.5)
      .attr('pointer-events', 'none');

    // Labels
    const label = g
      .append('g')
      .selectAll<SVGTextElement, NodeDatum>('text')
      .data(nodes as NodeDatum[])
      .join('text')
      .text((d) => d.name)
      .attr('text-anchor', 'middle')
      .attr('font-size', '9px')
      .attr('fill', 'var(--color-on-surface)')
      .attr('fill-opacity', (d) => labelOpacity(d))
      .attr('pointer-events', 'none')
      .attr('user-select', 'none');

    // Ghost nodes: a hollow dashed ring, no fill. Deliberately NOT given a
    // fill-opacity attribute -- that attribute is how the data-node circles are
    // told apart from everything else on the canvas (see tests/lab-network.spec.ts).
    type GhostDatum = typeof ghostNodes[0] & d3.SimulationNodeDatum;
    const ghostNode = g
      .append('g')
      .attr('class', 'network__ghost-nodes')
      .selectAll<SVGCircleElement, GhostDatum>('circle')
      .data(ghostNodes as GhostDatum[])
      .join('circle')
      .attr('r', GHOST_RADIUS)
      .attr('fill', 'none')
      .attr('stroke', 'var(--color-on-surface)')
      .attr('stroke-width', 1)
      .attr('stroke-dasharray', '2,2')
      .attr('opacity', 0.6)
      .attr('pointer-events', 'none');

    const ghostLabel = g
      .append('g')
      .selectAll<SVGTextElement, GhostDatum>('text')
      .data(ghostNodes as GhostDatum[])
      .join('text')
      .text((d) => d.name)
      .attr('text-anchor', 'middle')
      .attr('font-size', '9px')
      .attr('fill', 'var(--color-on-surface)')
      .attr('opacity', 0.5)
      .attr('pointer-events', 'none')
      .attr('user-select', 'none');

    const MIN_TOUCH_RADIUS = 22; // 44px diameter — WCAG 2.5.5

    // Hit-area circles for 44px touch targets (MOB-04).
    // Rendered above visible nodes and labels so they capture all pointer events.
    const hitArea = g
      .append('g')
      .attr('class', 'network__hit-area')
      .selectAll<SVGCircleElement, NodeDatum>('circle')
      .data(nodes as NodeDatum[])
      .join('circle')
      .attr('r', (d) => Math.max(MIN_TOUCH_RADIUS, radiusScale(d.playcount)))
      .attr('fill', 'transparent')
      .attr('cursor', 'pointer')
      .attr('pointer-events', 'all');

    // Tracks whether each in-progress drag has crossed the movement threshold
    // and reheated the simulation. Prevents pointer jitter on click-and-hold
    // from triggering alphaTarget(0.3) and letting charge force repel nodes.
    // (Originally fixed in 055b462; reverted by the free-flowing layout rewrite.)
    const nodeDragReheated = new Map<NodeDatum, boolean>();

    hitArea.call(
      d3
        .drag<SVGCircleElement, NodeDatum>()
        .on('start', (_event, d) => {
          // Pin in place; do NOT reheat on press — reheating here repels
          // other nodes via the charge force.
          d.fx = d.x;
          d.fy = d.y;
          nodeDragReheated.set(d, false);
        })
        .on('drag', (event, d) => {
          if (!nodeDragReheated.get(d)) {
            const dx = event.x - (d.fx ?? event.x);
            const dy = event.y - (d.fy ?? event.y);
            if (dx * dx + dy * dy < 16) return; // < 4px — jitter, don't reheat
            nodeDragReheated.set(d, true);
            simulation.alphaTarget(0.3).restart();
          }
          d.fx = event.x;
          d.fy = event.y;
        })
        .on('end', (event, d) => {
          nodeDragReheated.delete(d);
          if (!event.active) simulation.alphaTarget(0);
          d.fx = null;
          d.fy = null;
        })
    );

    // Ghost hit areas: same 44px touch target as artist nodes, in their own
    // group so '.network__hit-area' stays "artist nodes only". Not draggable --
    // a ghost is positioned by its tether.
    const ghostHit = g
      .append('g')
      .attr('class', 'network__ghost-hit')
      .selectAll<SVGCircleElement, GhostDatum>('circle')
      .data(ghostNodes as GhostDatum[])
      .join('circle')
      .attr('r', MIN_TOUCH_RADIUS)
      .attr('fill', 'transparent')
      .attr('cursor', 'pointer')
      .attr('pointer-events', 'all');

    // --- Filter opacity constants ---
    const GHOST_OPACITY = 0.08;
    const EDGE_GHOST_OPACITY = 0.05;
    const FULL_NODE_OPACITY = 0.95;
    // Ghost (outside-influence) edges only; artist edges use edgeOpacity().
    const FULL_EDGE_OPACITY = 0.50;

    function applyFilters() {
      const { searchTerm, selectedTag, selectedFamily, similarityThreshold } = state;

      // 1. Compute which links are below the similarity threshold
      const hiddenLinkIndices = new Set<number>();
      links.forEach((l, i) => {
        const sim = (l as { similarity?: number }).similarity ?? 0;
        if (sim < similarityThreshold) {
          hiddenLinkIndices.add(i);
        }
      });

      // 2. Compute connected nodes (only relevant when threshold > 0)
      const connectedNodeIds = new Set<string>();
      if (similarityThreshold > 0) {
        links.forEach((l, i) => {
          if (!hiddenLinkIndices.has(i)) {
            const src = typeof l.source === 'object'
              ? (l.source as { id: string }).id : l.source as string;
            const tgt = typeof l.target === 'object'
              ? (l.target as { id: string }).id : l.target as string;
            connectedNodeIds.add(src);
            connectedNodeIds.add(tgt);
          }
        });
      }

      // 3. Determine ghosted nodes (fail ANY filter = ghosted)
      const ghostedNodes = new Set<string>();
      nodes.forEach((n) => {
        const nameMatch = searchTerm === ''
          || n.name.toLowerCase().includes(searchTerm.toLowerCase());
        const tagMatch = selectedTag === ''
          || (nodeTagSet.get(n.id) ?? new Set()).has(selectedTag);
        // Legend filter (STC-339). Intersects with the others, same as search
        // and the tag dropdown already do (SEARCH-04).
        const familyMatch = selectedFamily === ''
          || genreFamilySlug(nodeFamily.get(n.id) ?? 'other') === selectedFamily;
        const thresholdMatch = similarityThreshold === 0
          || connectedNodeIds.has(n.id);
        if (!nameMatch || !tagMatch || !familyMatch || !thresholdMatch) {
          ghostedNodes.add(n.id);
        }
      });

      // 4. Apply opacity to nodes and labels
      // One transition for both attributes: a second unnamed node.transition()
      // would interrupt this one and the fill would never change.
      node
        .transition()
        .duration(150)
        .attr('fill-opacity', (d: any) => (ghostedNodes.has(d.id) ? GHOST_OPACITY : FULL_NODE_OPACITY))
        .attr('stroke-opacity', (d: any) => (ghostedNodes.has(d.id) ? GHOST_OPACITY : 1));
      label.transition().duration(150).attr('fill-opacity', (d: any) =>
        // A label that is hidden by design stays hidden when ghosted, rather
        // than fading up to the ghost opacity.
        labelOpacity(d) === 0 ? 0 : ghostedNodes.has(d.id) ? GHOST_OPACITY : labelOpacity(d)
      );

      // 5. Apply opacity to edges
      link.transition().duration(150).attr('stroke-opacity', (l: any) => {
        const src = typeof l.source === 'object'
          ? (l.source as { id: string }).id : l.source as string;
        const tgt = typeof l.target === 'object'
          ? (l.target as { id: string }).id : l.target as string;
        const sim = (l as { similarity?: number }).similarity ?? 0;
        // Undrawn (tag-only) edges stay undrawn however the filters are set.
        if (edgeOpacity(l) === 0) return 0;
        if ((similarityThreshold > 0 && sim < similarityThreshold)
            || ghostedNodes.has(src)
            || ghostedNodes.has(tgt)) {
          return EDGE_GHOST_OPACITY;
        }
        return edgeOpacity(l);
      });

      // Sync arrowhead visibility with edge ghost state (VIS-01, Pitfall 3)
      // SVG markers do not inherit stroke-opacity — must toggle marker-end to null explicitly
      link.attr('marker-end', (l: any) => {
        const ld = l as { influenceDirection?: string };
        if (!ld.influenceDirection) return null;
        const src = typeof l.source === 'object'
          ? (l.source as { id: string }).id : l.source as string;
        const tgt = typeof l.target === 'object'
          ? (l.target as { id: string }).id : l.target as string;
        const sim = (l as { similarity?: number }).similarity ?? 0;
        const ghosted = (similarityThreshold > 0 && sim < similarityThreshold)
          || ghostedNodes.has(src) || ghostedNodes.has(tgt);
        return ghosted ? null : 'url(#arrowhead)';
      });

      // Ghost influencers follow the artists they influenced: dimmed once every
      // one of those artists is. They are not subject to the similarity cutoff
      // themselves -- an influence claim has no similarity score, so applying
      // one would dim every ghost the moment the slider moved off zero. A
      // search hit on the ghost's own name keeps it lit.
      const dimmedGhosts = new Set<string>();
      ghostNodes.forEach((gn) => {
        const searchHit = searchTerm !== '' && gn.name.toLowerCase().includes(searchTerm.toLowerCase());
        const allDimmed = (ghostTargets.get(gn.id) ?? []).every((id) => ghostedNodes.has(id));
        if (!searchHit && allDimmed) dimmedGhosts.add(gn.id);
      });
      ghostNode.transition().duration(150).attr('opacity', (d) => (dimmedGhosts.has(d.id) ? GHOST_OPACITY : 0.6));
      ghostLabel.transition().duration(150).attr('opacity', (d) => (dimmedGhosts.has(d.id) ? GHOST_OPACITY : 0.5));
      const ghostEdgeDimmed = (l: { source: unknown; target: unknown }) => {
        const src = (l.source as { id: string }).id;
        const tgt = (l.target as { id: string }).id;
        return dimmedGhosts.has(src) || ghostedNodes.has(tgt);
      };
      ghostLink
        .transition()
        .duration(150)
        .attr('stroke-opacity', (l) => (ghostEdgeDimmed(l) ? EDGE_GHOST_OPACITY : FULL_EDGE_OPACITY));
      ghostLink.attr('marker-end', (l) => (ghostEdgeDimmed(l) ? null : 'url(#arrowhead)'));

      refreshPanelState();
    }

    // Genre nodes (hidden until genre toggle is ON)
    const genreDragReheated = new Map<GenreNodeDatum, boolean>();
    const genreNodeGroup = g.append('g').style('display', 'none');

    const genreNodeCircle = genreNodeGroup
      .selectAll<SVGCircleElement, GenreNodeDatum>('circle')
      .data(genreNodes)
      .join('circle')
      .attr('r', (d) => d.radius)
      .attr('fill', 'none')
      .attr('stroke', 'var(--color-on-surface)')
      .attr('stroke-width', 1)
      .attr('cursor', 'pointer')
      .attr('pointer-events', 'all')
      .call(
        d3.drag<SVGCircleElement, GenreNodeDatum>()
          .on('start', (_event, d) => {
            // Pin in place without reheating — see artist drag handler for rationale.
            d.fx = d.x;
            d.fy = d.y;
            genreDragReheated.set(d, false);
          })
          .on('drag', (event, d) => {
            if (!genreDragReheated.get(d)) {
              const dx = event.x - (d.fx ?? event.x);
              const dy = event.y - (d.fy ?? event.y);
              if (dx * dx + dy * dy < 16) return;
              genreDragReheated.set(d, true);
              simulation.alphaTarget(0.3).restart();
            }
            d.fx = event.x;
            d.fy = event.y;
          })
          .on('end', (event, d) => {
            genreDragReheated.delete(d);
            if (!event.active) simulation.alphaTarget(0);
            d.fx = null;
            d.fy = null;
          })
      );

    const genreNodeLabel = genreNodeGroup
      .selectAll<SVGTextElement, GenreNodeDatum>('text')
      .data(genreNodes)
      .join('text')
      .attr('class', 'network__genre-label')
      .text((d) => d.name)
      .attr('text-anchor', 'middle')
      .attr('dominant-baseline', 'middle')
      .attr('font-size', '10px')
      .attr('fill', 'var(--color-on-surface)')
      .attr('pointer-events', 'none')
      .attr('user-select', 'none');

    // --- Genre toggle function ---
    function toggleGenre(on: boolean) {
      if (on) {
        // Add genre nodes to simulation
        simulation.nodes([...(nodes as d3.SimulationNodeDatum[]), ...ghostNodes, ...genreNodes]);
        // Replace link force with combined artist + ghost + genre links
        simulation.force(
          'link',
          d3.forceLink([...links, ...ghostLinks, ...genreLinks, ...genreLinks2])
            .id((d) => (d as { id: string }).id)
            .distance(linkDistance)
            .strength(linkStrength)
        );
        genreLinkGroup.style('display', '');
        genreLink2Group.style('display', '');
        genreNodeGroup.style('display', '');
      } else {
        // Reset genre nodes to pole positions for next time
        genres.forEach((genre, i) => {
          const angle = (2 * Math.PI * i) / genres.length;
          const gn = genreNodes[i];
          gn.x = cx + poleRadius * Math.cos(angle);
          gn.y = cy + poleRadius * Math.sin(angle);
          gn.vx = 0;
          gn.vy = 0;
          gn.fx = null;
          gn.fy = null;
        });
        // Restore artist-only nodes
        simulation.nodes([...(nodes as d3.SimulationNodeDatum[]), ...ghostNodes]);
        // Restore similarity-driven link force
        simulation.force(
          'link',
          d3.forceLink([...links, ...ghostLinks])
            .id((d) => (d as { id: string }).id)
            .distance(linkDistance)
            .strength(linkStrength)
        );
        genreLinkGroup.style('display', 'none');
        genreLink2Group.style('display', 'none');
        genreNodeGroup.style('display', 'none');
      }
      simulation.alpha(0.3).alphaTarget(0).restart();
    }

    // Tooltip
    const tooltip = d3
      .select(container)
      .append('div')
      .style('position', 'absolute')
      .style('background', 'var(--color-surface)')
      .style('border', '1px solid var(--color-border)')
      .style('padding', '8px 12px')
      .style('font-size', 'var(--text-body-medium)')
      .style('pointer-events', 'none')
      .style('opacity', '0')
      .style('transition', 'opacity 0.15s')
      .style('max-width', '200px')
      .style('z-index', '10');

    // Edge tooltip timer
    let edgeTooltipTimer: ReturnType<typeof setTimeout> | null = null;

    hitArea
      .on('mouseenter', (event: MouseEvent, d: NodeDatum) => {
        // Cancel any pending edge tooltip when entering a node
        if (edgeTooltipTimer) { clearTimeout(edgeTooltipTimer); edgeTooltipTimer = null; }
        let html = `<strong>${escapeHtml(d.name)}</strong>`;
        const formed = nodeChronology[d.id];
        if (formed) html += `<div>formed ${formed}</div>`;
        tooltip.style('transition', 'opacity 0.15s').html(html).style('opacity', '1');
        const rect = container.getBoundingClientRect();
        tooltip
          .style('left', `${event.clientX - rect.left + 14}px`)
          .style('top', `${Math.max(8, event.clientY - rect.top - 36)}px`);
      })
      .on('mousemove', (event: MouseEvent) => {
        const rect = container.getBoundingClientRect();
        tooltip
          .style('left', `${event.clientX - rect.left + 14}px`)
          .style('top', `${Math.max(8, event.clientY - rect.top - 36)}px`);
      })
      .on('mouseleave', () => tooltip.style('opacity', '0'))
      .on('click', (_event: MouseEvent, d: NodeDatum) => {
        try {
          const parsed = new URL(d.url);
          if (parsed.protocol === 'https:' || parsed.protocol === 'http:') {
            window.open(d.url, '_blank', 'noopener,noreferrer');
          }
        } catch {
          // invalid URL — silently ignore
        }
      });

    // Ghost influencer tooltip + click-through to its Last.fm page.
    const placeTooltip = (event: MouseEvent) => {
      const rect = container.getBoundingClientRect();
      tooltip
        .style('left', `${event.clientX - rect.left + 14}px`)
        .style('top', `${Math.max(8, event.clientY - rect.top - 36)}px`);
    };
    ghostHit
      .on('mouseenter', (event: MouseEvent, d: GhostDatum) => {
        if (edgeTooltipTimer) { clearTimeout(edgeTooltipTimer); edgeTooltipTimer = null; }
        const html =
          `<strong>${escapeHtml(d.name)}</strong>` +
          `<div>influenced ${escapeHtml(d.influenced.join(', '))}</div>` +
          `<div>not in this period\u2019s top 100</div>`;
        tooltip.style('transition', 'opacity 0.15s').html(html).style('opacity', '1');
        placeTooltip(event);
      })
      .on('mousemove', placeTooltip)
      .on('mouseleave', () => tooltip.style('opacity', '0'))
      .on('click', (_event: MouseEvent, d: GhostDatum) => {
        try {
          const parsed = new URL(d.url);
          if (parsed.protocol === 'https:' || parsed.protocol === 'http:') {
            window.open(d.url, '_blank', 'noopener,noreferrer');
          }
        } catch {
          // invalid URL — silently ignore
        }
      });

    // Edge tooltip: 200ms delay, immediate dismiss
    linkHit
      .on('mouseenter', (event: MouseEvent, d: any) => {
        edgeTooltipTimer = setTimeout(() => {
          // Extend cast to include influenceDirection (VIS-02)
          const ld = d as { influenceDirection?: string; sharedTags?: string[]; similarity?: number };
          const src = (d.source as { name?: string }).name ?? '';
          const tgt = (d.target as { name?: string }).name ?? '';
          let html = '';

          // Direction line for influence edges (D-04, D-06), combined with its
          // leading shared tag on one line (STC-334) -- "A → B, via <tag>" is
          // the one payload that teaches a viewer something a glance at the
          // graph can't already tell them.
          // See the authoritative encoding comment above influenceLinks.forEach.
          const primaryTag = (ld.sharedTags ?? [])[0];
          const via = primaryTag ? `, via ${escapeHtml(primaryTag)}` : '';
          if (ld.influenceDirection === 'forward') {
            html += `<div>${escapeHtml(tgt)} → ${escapeHtml(src)}${via}</div>`;
          } else if (ld.influenceDirection === 'reverse') {
            html += `<div>${escapeHtml(src)} → ${escapeHtml(tgt)}${via}</div>`;
          }
          // No direction line for similarity-only edges (D-05)

          // Shared tags line (omit if empty) -- influence edges already fold
          // their leading tag into the direction line above, so only list
          // tags here for non-influence edges.
          if (!ld.influenceDirection) {
            const tags = (ld.sharedTags ?? []).map((t: string) => escapeHtml(t)).join(', ');
            if (tags) html += `<div>${tags}</div>`;
          }

          // Similarity score (always shown)
          html += `<div>similarity: ${(ld.similarity ?? 0).toFixed(2)}</div>`;

          tooltip.style('transition', 'opacity 0.15s').html(html).style('opacity', '1');
          const rect = container.getBoundingClientRect();
          tooltip
            .style('left', `${event.clientX - rect.left + 14}px`)
            .style('top', `${Math.max(8, event.clientY - rect.top - 36)}px`);
        }, 200);
      })
      .on('mousemove', (event: MouseEvent) => {
        const rect = container.getBoundingClientRect();
        tooltip
          .style('left', `${event.clientX - rect.left + 14}px`)
          .style('top', `${Math.max(8, event.clientY - rect.top - 36)}px`);
      })
      .on('mouseleave', () => {
        if (edgeTooltipTimer) { clearTimeout(edgeTooltipTimer); edgeTooltipTimer = null; }
        // D-08: immediate dismiss — override transition
        tooltip.style('transition', 'none').style('opacity', '0');
      });

    // Tick: pull fresh positions out of the simulation state into the DOM.
    // Extracted so we can also invoke it manually after pre-settling the
    // layout (simulation.tick() advances state but does not fire 'tick').
    type SimLink = { source: d3.SimulationNodeDatum; target: d3.SimulationNodeDatum };
    function updatePositions() {
      link
        .attr('x1', (d: any) => {
          const s = (d as unknown as SimLink).source;
          const t = (d as unknown as SimLink).target;
          const ld = d as { influenceDirection?: string };
          // 'forward': swap — draw from target (influencer) toward source (influenced)
          if (ld.influenceDirection === 'forward') return (t as any).x ?? 0;
          return (s as any).x ?? 0;
        })
        .attr('y1', (d: any) => {
          const s = (d as unknown as SimLink).source;
          const t = (d as unknown as SimLink).target;
          const ld = d as { influenceDirection?: string };
          if (ld.influenceDirection === 'forward') return (t as any).y ?? 0;
          return (s as any).y ?? 0;
        })
        .attr('x2', (d: any) => {
          const s = (d as unknown as SimLink).source;
          const t = (d as unknown as SimLink).target;
          const ld = d as { influenceDirection?: string };
          // Determine visual endpoint (influenced artist)
          const visualEnd = ld.influenceDirection === 'forward' ? s : t;
          const visualStart = ld.influenceDirection === 'forward' ? t : s;
          if (!ld.influenceDirection) return (t as any).x ?? 0; // non-influence: raw
          const ex = (visualEnd as any).x ?? 0, ey = (visualEnd as any).y ?? 0;
          const ox = (visualStart as any).x ?? 0, oy = (visualStart as any).y ?? 0;
          const dx = ex - ox, dy = ey - oy;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist === 0) return ex;
          const retract = radiusScale((visualEnd as any).playcount ?? 0) + 5;
          return ex - (dx / dist) * retract;
        })
        .attr('y2', (d: any) => {
          const s = (d as unknown as SimLink).source;
          const t = (d as unknown as SimLink).target;
          const ld = d as { influenceDirection?: string };
          const visualEnd = ld.influenceDirection === 'forward' ? s : t;
          const visualStart = ld.influenceDirection === 'forward' ? t : s;
          if (!ld.influenceDirection) return (t as any).y ?? 0;
          const ex = (visualEnd as any).x ?? 0, ey = (visualEnd as any).y ?? 0;
          const ox = (visualStart as any).x ?? 0, oy = (visualStart as any).y ?? 0;
          const dx = ex - ox, dy = ey - oy;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist === 0) return ey;
          const retract = radiusScale((visualEnd as any).playcount ?? 0) + 5;
          return ey - (dy / dist) * retract;
        });

      linkHit
        .attr('x1', (d: any) => ((d as unknown as SimLink).source.x ?? 0))
        .attr('y1', (d: any) => ((d as unknown as SimLink).source.y ?? 0))
        .attr('x2', (d: any) => ((d as unknown as SimLink).target.x ?? 0))
        .attr('y2', (d: any) => ((d as unknown as SimLink).target.y ?? 0));

      node
        .attr('cx', (d) => (d as d3.SimulationNodeDatum).x ?? 0)
        .attr('cy', (d) => (d as d3.SimulationNodeDatum).y ?? 0);

      hitArea
        .attr('cx', (d) => (d as d3.SimulationNodeDatum).x ?? 0)
        .attr('cy', (d) => (d as d3.SimulationNodeDatum).y ?? 0);

      label
        .attr('x', (d) => (d as d3.SimulationNodeDatum).x ?? 0)
        .attr('y', (d) => ((d as d3.SimulationNodeDatum).y ?? 0) + radiusScale(d.playcount) + 11);

      ghostNode
        .attr('cx', (d) => (d as d3.SimulationNodeDatum).x ?? 0)
        .attr('cy', (d) => (d as d3.SimulationNodeDatum).y ?? 0);
      ghostHit
        .attr('cx', (d) => (d as d3.SimulationNodeDatum).x ?? 0)
        .attr('cy', (d) => (d as d3.SimulationNodeDatum).y ?? 0);
      ghostLabel
        .attr('x', (d) => (d as d3.SimulationNodeDatum).x ?? 0)
        .attr('y', (d) => ((d as d3.SimulationNodeDatum).y ?? 0) + GHOST_RADIUS + 11);

      // Ghost edges run influencer (source) -> influenced (target); retract the
      // arrow tip to the influenced node's rim so it isn't hidden under it.
      const ghostEdgeEnd = (d: SimLink, axis: 'x' | 'y') => {
        const s = d.source as d3.SimulationNodeDatum;
        const t = d.target as d3.SimulationNodeDatum & { playcount?: number };
        const sx = s.x ?? 0, sy = s.y ?? 0, tx = t.x ?? 0, ty = t.y ?? 0;
        const dx = tx - sx, dy = ty - sy;
        const dist = Math.sqrt(dx * dx + dy * dy);
        if (dist === 0) return axis === 'x' ? tx : ty;
        const retract = radiusScale(t.playcount ?? 0) + 5;
        return axis === 'x' ? tx - (dx / dist) * retract : ty - (dy / dist) * retract;
      };
      ghostLink
        .attr('x1', (d) => ((d as unknown as SimLink).source.x ?? 0))
        .attr('y1', (d) => ((d as unknown as SimLink).source.y ?? 0))
        .attr('x2', (d) => ghostEdgeEnd(d as unknown as SimLink, 'x'))
        .attr('y2', (d) => ghostEdgeEnd(d as unknown as SimLink, 'y'));

      if (state.groupByGenre) {
        genreLinkSel
          .attr('x1', (d) => ((d as unknown as SimLink).source.x ?? 0))
          .attr('y1', (d) => ((d as unknown as SimLink).source.y ?? 0))
          .attr('x2', (d) => ((d as unknown as SimLink).target.x ?? 0))
          .attr('y2', (d) => ((d as unknown as SimLink).target.y ?? 0));

        genreLink2Sel
          .attr('x1', (d) => ((d as unknown as SimLink).source.x ?? 0))
          .attr('y1', (d) => ((d as unknown as SimLink).source.y ?? 0))
          .attr('x2', (d) => ((d as unknown as SimLink).target.x ?? 0))
          .attr('y2', (d) => ((d as unknown as SimLink).target.y ?? 0));

        genreNodeCircle
          .attr('cx', (d) => d.x ?? 0)
          .attr('cy', (d) => d.y ?? 0);

        genreNodeLabel
          .attr('x', (d) => d.x ?? 0)
          .attr('y', (d) => d.y ?? 0);
      }
    }
    simulation.on('tick', updatePositions);

    // Paint the pre-settled layout immediately.
    updatePositions();

    // Zoom-to-fit: compute the bounding box of the settled layout and
    // apply an initial zoom transform so the entire graph is visible on
    // first paint, regardless of viewport size. This is what actually
    // lets mobile users see the whole graph without panning first.
    if (nodes.length === 0) return;
    {
      const margin = 40;
      let minX = Infinity;
      let maxX = -Infinity;
      let minY = Infinity;
      let maxY = -Infinity;
      // Ghosts are included so the influencers tethered at the edge of the
      // graph aren't cropped out of the first view.
      ([...nodes, ...ghostNodes] as d3.SimulationNodeDatum[]).forEach((n) => {
        const r = radiusScale((n as { playcount?: number }).playcount ?? 0);
        const nx = n.x ?? 0;
        const ny = n.y ?? 0;
        if (nx - r < minX) minX = nx - r;
        if (nx + r > maxX) maxX = nx + r;
        if (ny - r < minY) minY = ny - r;
        if (ny + r > maxY) maxY = ny + r;
      });
      const bw = Math.max(maxX - minX + margin * 2, 1);
      const bh = Math.max(maxY - minY + margin * 2, 1);
      const fitScale = Math.min(width / bw, height / bh, 1);
      const clampedScale = Math.max(0.1, fitScale);
      const bcx = (minX + maxX) / 2;
      const bcy = (minY + maxY) / 2;
      const tx = width / 2 - bcx * clampedScale;
      const ty = height / 2 - bcy * clampedScale;
      svg.call(
        zoomBehavior.transform,
        d3.zoomIdentity.translate(tx, ty).scale(clampedScale)
      );
    }

    // --- Fullscreen ---
    const onFullscreenChange = () => {
      const isFullscreen = !!document.fullscreenElement;
      state.fullscreen = isFullscreen;

      const newWidth = isFullscreen ? window.innerWidth : width;
      const newHeight = isFullscreen ? window.innerHeight : height;

      svg.attr('width', newWidth).attr('height', newHeight);
      simulation.force('x', d3.forceX(newWidth / 2).strength(0.012));
      simulation.force('y', d3.forceY(newHeight / 2).strength(0.012));
      simulation.alpha(0.3).alphaTarget(0).restart();

      if (btnFullscreen) {
        btnFullscreen.textContent = isFullscreen ? '✕ exit' : '⤢ fullscreen';
        btnFullscreen.classList.toggle('network__control--active', isFullscreen);
        btnFullscreen.setAttribute('aria-pressed', String(isFullscreen));
      }
    };
    document.addEventListener('fullscreenchange', onFullscreenChange);

    // Clean up the fullscreenchange listener on Astro view transitions to prevent
    // listener stacking when initNetwork() is re-run after navigating away and back.
    document.addEventListener('astro:before-swap', () => {
      document.removeEventListener('fullscreenchange', onFullscreenChange);
    }, { once: true });

    btnFullscreen?.addEventListener('click', () => {
      if (!state.fullscreen) {
        // The stage, not just the canvas: the controls float over it and would
        // vanish from a fullscreen canvas.
        (document.getElementById('network-stage') ?? container).requestFullscreen().catch((err) => {
          console.warn('[network] requestFullscreen failed:', err);
        });
      } else {
        document.exitFullscreen();
      }
    });

    // --- Genre toggle ---
    btnGenre?.addEventListener('click', () => {
      const next = !state.groupByGenre;
      try {
        toggleGenre(next);
        state.groupByGenre = next;
        btnGenre.classList.toggle('network__control--active', next);
        btnGenre.setAttribute('aria-pressed', String(next));
      } catch (err) {
        console.error('[network] genre toggle failed:', err);
      }
    });

    // --- Search filter ---
    document.getElementById('ctrl-search')?.addEventListener('input', (e) => {
      state.searchTerm = (e.target as HTMLInputElement).value;
      applyFilters();
    });

    // --- Genre/tag filter ---
    const genreSelect = document.getElementById('ctrl-genre-filter') as HTMLSelectElement | null;
    if (genreSelect) {
      allTags.forEach((tag) => {
        const opt = document.createElement('option');
        opt.value = tag;
        opt.textContent = tag;
        genreSelect.appendChild(opt);
      });
      genreSelect.addEventListener('change', (e) => {
        state.selectedTag = (e.target as HTMLSelectElement).value;
        applyFilters();
      });
    }

    // --- Similarity threshold ---
    const thresholdInput = document.getElementById('ctrl-threshold') as HTMLInputElement | null;
    thresholdInput?.addEventListener('input', (e) => {
      const val = parseFloat((e.target as HTMLInputElement).value);
      state.similarityThreshold = val;
      setThresholdLabel(val);
      applyFilters();
    });

    function setThresholdLabel(val: number) {
      const text = document.getElementById('ctrl-threshold-text');
      if (text) text.textContent = `min similarity: ${val.toFixed(1)}`;
      thresholdInput?.setAttribute('aria-valuetext', val.toFixed(1));
    }

    // Live readout under the slider: how many of the drawn links survive the
    // cutoff. Only links that are actually drawn count (similarity or
    // influence); tag-only links are not drawn, so they are not part of the total.
    const drawnLinks = links.filter((l) => edgeOpacity(l as StyledLink) > 0);
    function refreshLinkReadout() {
      const el = document.getElementById('ctrl-link-count');
      if (!el) return;
      const kept = drawnLinks.filter(
        (l) => ((l as StyledLink).similarity ?? 0) >= state.similarityThreshold
      ).length;
      el.textContent =
        state.similarityThreshold > 0
          ? `${kept} of ${drawnLinks.length} links`
          : `${drawnLinks.length} links`;
    }

    // --- Filters panel: collapse, active-filter badge, clear ---
    const panelToggle = document.getElementById('ctrl-panel-toggle') as HTMLButtonElement | null;
    const panelBody = document.getElementById('network-panel-body');
    const clearBtn = document.getElementById('ctrl-clear') as HTMLButtonElement | null;
    const activeCount = document.getElementById('ctrl-active-count');

    function setPanelOpen(open: boolean) {
      panelToggle?.setAttribute('aria-expanded', String(open));
      if (panelBody) panelBody.hidden = !open;
    }
    panelToggle?.addEventListener('click', () => {
      setPanelOpen(panelToggle.getAttribute('aria-expanded') !== 'true');
    });
    // On a phone the panel starts folded so it doesn't cover the graph.
    setPanelOpen(!window.matchMedia('(max-width: 480px)').matches);

    function refreshPanelState() {
      const n =
        (state.searchTerm !== '' ? 1 : 0) +
        (state.selectedTag !== '' ? 1 : 0) +
        (state.selectedFamily !== '' ? 1 : 0) +
        (state.similarityThreshold > 0 ? 1 : 0);
      if (activeCount) {
        activeCount.textContent = String(n);
        activeCount.hidden = n === 0;
      }
      if (clearBtn) clearBtn.hidden = n === 0;
      refreshLinkReadout();
    }

    clearBtn?.addEventListener('click', () => {
      state.searchTerm = '';
      state.selectedTag = '';
      state.selectedFamily = '';
      state.similarityThreshold = 0;
      const search = document.getElementById('ctrl-search') as HTMLInputElement | null;
      if (search) search.value = '';
      if (genreSelect) genreSelect.value = '';
      if (thresholdInput) thresholdInput.value = '0';
      setThresholdLabel(0);
      legendButtons.forEach((b) => b.setAttribute('aria-pressed', 'false'));
      applyFilters();
    });

    refreshPanelState();
  }

  initNetwork();
</script>

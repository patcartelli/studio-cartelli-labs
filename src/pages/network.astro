---
// src/pages/lab/network.astro
// SSR: serves network graph data from KV cache (getCachedNetworkData).
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import type { Artist } from '../lib/lastfm';
import { getCachedNetworkData } from '../lib/network-cache';
import { changelog } from '../data/changelog';
import { GENRE_FAMILIES, genreFamilySlug, type GenreFamily } from '../lib/genre-families';
import { deriveGhostInfluences, type GhostNode, type GhostLink } from '../lib/network-ghosts';

// Legend entries: the three coloured families, then the uncoloured bucket.
const legendFamilies: GenreFamily[] = [...GENRE_FAMILIES, 'other'];

const networkChangelog = changelog.filter((e) => e.project === 'network');

function formatDate(iso: string): string {
  const [y, m, d] = iso.split('-');
  const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  return `${months[Number(m) - 1]} ${Number(d)}, ${y}`;
}

// --- Types ---
interface GraphNode {
  id: string;
  name: string;
  playcount: number;
  url: string;
}

interface GraphLink {
  source: string;
  target: string;
  sharedTags: string[];
  similarity: number;
  influenceDirection?: 'forward' | 'reverse';
}

interface GraphData {
  nodes: GraphNode[];
  links: GraphLink[];
}

// --- Period param ---
const VALID_PERIODS = ['7day', '1month', '3month', '6month', '12month'] as const;
type Period = (typeof VALID_PERIODS)[number];

const rawPeriod = Astro.url.searchParams.get('period') ?? '';
const period: Period = (VALID_PERIODS as readonly string[]).includes(rawPeriod)
  ? (rawPeriod as Period)
  : '1month';

// --- Env (runtime bindings via Cloudflare Workers API) ---
import { env } from 'cloudflare:workers';
const cfEnv = env as { LASTFM_API_KEY?: string; LASTFM_USERNAME?: string };
const kv = (env as unknown as { LASTFM_CHART_CACHE: KVNamespace }).LASTFM_CHART_CACHE;

let hasError = false;
let graphData: GraphData = { nodes: [], links: [] };
// Outside influencers (Wikidata P737 targets not in this period's top 100),
// drawn as ghost nodes. Kept out of graphData so the node/link counts and
// everything keyed off graphData.nodes keep meaning "your artists".
let ghostData: { nodes: GhostNode[]; links: GhostLink[] } = { nodes: [], links: [] };
let isStale = false;
let fetchedAt = 0; // assigned in successful fetch path only
let uniqueTags: string[] = [];
let nodeTagsMap: Record<string, string[]> = {};
let nodeChronologyMap: Record<string, number> = {};

function formatRelativeAge(ts: number): string {
  const ageMs = Date.now() - ts;
  const ageSec = Math.floor(ageMs / 1000);
  const ageMin = Math.floor(ageSec / 60);
  if (ageSec < 60) return 'just now';
  if (ageMin === 1) return '1 min ago';
  if (ageMin < 60) return `${ageMin} min ago`;
  const ageHr = Math.floor(ageMin / 60);
  if (ageHr === 1) return '1 hr ago';
  return `${ageHr} hr ago`;
}

// Deliberately does NOT precondition on LASTFM_API_KEY/LASTFM_USERNAME the
// way an earlier version did: that blocked LASTFM_FIXTURE mode (which needs
// no credentials -- fetchLastfm's fixture short-circuit runs before its own
// credential guard, see lastfm-fixture.ts) from ever reaching the fetch
// below, so every data-gated Playwright test in tests/lab-network.spec.ts
// hit its `if (errorVisible) { skip }` branch and silently no-op'ed in CI --
// the exact false-green failure mode lastfm-fixture.ts's own header
// describes for /lab/chart, just never fixed here too (STC-344).
// chart.astro's pattern (try the fetch, let missing real credentials throw
// and land in the catch below) is what actually needs to happen for both
// pages.
if (!kv) {
  hasError = true;
} else {
  try {
    const result = await getCachedNetworkData(kv, cfEnv, period);
    isStale = result.isStale;
    fetchedAt = result.fetchedAt;

    const { artists, allTags, allSimilar, influences: influenceLinks, chronology } = result.data;
    const artistNames = artists.map((a) => a.name);
    const artistSet = new Set(artistNames.map((n) => n.toLowerCase()));

    // --- Build nodes ---
    const nodes: GraphNode[] = artists.map((a) => ({
      id: a.id,
      name: a.name,
      playcount: a.playcount,
      url: a.url,
    }));

    // --- Build edge maps ---
    // sharedTagsMap: sorted key -> string[]
    const sharedTagsMap = new Map<string, string[]>();
    // similarityMap: sorted key -> number
    const similarityMap = new Map<string, number>();
    // influenceMap: sorted key -> 'forward' | 'reverse'
    const influenceMap = new Map<string, 'forward' | 'reverse'>();

    function edgeKey(a: string, b: string): string {
      return a < b ? `${a}|||${b}` : `${b}|||${a}`;
    }

    // Edges from shared tags: group artists by tag
    const tagToArtists = new Map<string, string[]>();
    artistNames.forEach((name, i) => {
      const tags = allTags[i] ?? [];
      tags.forEach((tag) => {
        if (!tagToArtists.has(tag)) tagToArtists.set(tag, []);
        tagToArtists.get(tag)!.push(name);
      });
    });

    tagToArtists.forEach((artistsWithTag, tag) => {
      for (let i = 0; i < artistsWithTag.length; i++) {
        for (let j = i + 1; j < artistsWithTag.length; j++) {
          const key = edgeKey(artistsWithTag[i], artistsWithTag[j]);
          if (!sharedTagsMap.has(key)) sharedTagsMap.set(key, []);
          const existing = sharedTagsMap.get(key)!;
          if (!existing.includes(tag)) existing.push(tag);
        }
      }
    });

    // Similarity edges: for each artist's similar list, if in our top-100 set
    artistNames.forEach((name, i) => {
      const similar = allSimilar[i] ?? [];
      similar.forEach(({ name: similarName, similarity }) => {
        if (artistSet.has(similarName.toLowerCase())) {
          // Find canonical name
          const canonicalSimilar = artistNames.find(
            (n) => n.toLowerCase() === similarName.toLowerCase()
          );
          if (canonicalSimilar) {
            const key = edgeKey(name, canonicalSimilar);
            const existing = similarityMap.get(key) ?? 0;
            similarityMap.set(key, Math.max(existing, similarity));
          }
        }
      });
    });

    // Influence edges from Wikidata: case-insensitive match to canonical names
    const lowerToCanonical = new Map<string, string>();
    artistNames.forEach((n) => lowerToCanonical.set(n.toLowerCase(), n));

    // === Wikidata influence direction encoding ===
    // P737 = "influenced by": `from` is the influenced artist, `to` is the influencer.
    // edgeKey() sorts alphabetically, so the canonical source/target in the serialized link
    // may not reflect influence flow. influenceDirection encodes this:
    //   'forward': link.source === canonicalFrom (influenced)  → arrow points: influencer→influenced
    //              updatePositions swaps x1/y1 to draw from target (influencer) to source (influenced)
    //   'reverse': link.source === canonicalTo (influencer)    → arrow points: influencer→influenced
    //              updatePositions uses x1/y1 as-is (source = influencer, target = influenced)
    influenceLinks.forEach(({ from, to }) => {
      const canonicalFrom = lowerToCanonical.get(from.toLowerCase());
      const canonicalTo = lowerToCanonical.get(to.toLowerCase());
      if (canonicalFrom && canonicalTo) {
        const key = edgeKey(canonicalFrom, canonicalTo);
        const direction: 'forward' | 'reverse' =
          key.startsWith(canonicalFrom + '|||') ? 'forward' : 'reverse';
        influenceMap.set(key, direction);
        // Also ensure there's a sharedTags entry so this edge is included
        if (!sharedTagsMap.has(key)) sharedTagsMap.set(key, []);
      }
    });

    // --- Assemble all unique link keys ---
    const allKeys = new Set<string>([
      ...sharedTagsMap.keys(),
      ...similarityMap.keys(),
      ...influenceMap.keys(),
    ]);

    const links: GraphLink[] = [];
    allKeys.forEach((key) => {
      const [source, target] = key.split('|||');
      const link: GraphLink = {
        source,
        target,
        sharedTags: sharedTagsMap.get(key) ?? [],
        similarity: similarityMap.get(key) ?? 0,
      };
      const influence = influenceMap.get(key);
      if (influence) link.influenceDirection = influence;
      links.push(link);
    });

    graphData = { nodes, links };

    const ghostInfluences = deriveGhostInfluences(artists, influenceLinks);
    ghostData = { nodes: ghostInfluences.ghosts, links: ghostInfluences.links };

    // Build unique tag list and per-node tag map for client-side filtering
    uniqueTags = [...new Set(allTags.flat())].sort((a, b) => a.localeCompare(b));
    artists.forEach((artist, i) => {
      nodeTagsMap[artist.id] = allTags[i] ?? [];
    });

    // STC-334: chronology (Wikidata P571 inception year), keyed by canonical
    // artist name like the influence links above -- case-insensitive match,
    // since Wikidata labels don't always match Last.fm names exactly.
    chronology.forEach(({ name, year }) => {
      const canonical = lowerToCanonical.get(name.toLowerCase());
      if (canonical) nodeChronologyMap[canonical] = year;
    });
  } catch (err) {
    console.error('[lab/network] data fetch failed:', err);
    hasError = true;
    graphData = { nodes: [], links: [] };
    ghostData = { nodes: [], links: [] };
  }
}

const periodLabels: Record<string, string> = {
  '7day': '7d',
  '1month': '1mo',
  '3month': '3mo',
  '6month': '6mo',
  '12month': '1yr',
};

const freshnessText = `updated ${formatRelativeAge(fetchedAt)}`;
const staleAgeText = formatRelativeAge(fetchedAt);
---

<BaseLayout title="Network" description="A network graph of artists and connections, built with D3." ogTitle="Network">
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400&family=Geist:wght@400;500&display=swap" />
  </Fragment>
  <section class="network container">
    <h1 class="network__heading">Network.</h1>

    {!hasError && (
      <p class="network__meta">
        {graphData.nodes.length} nodes &middot; {graphData.links.length} links &middot; {freshnessText}
      </p>
    )}

    {isStale && (
      <p class="network__stale-banner">
        Showing cached data from {staleAgeText} — Last.fm is currently unreachable
      </p>
    )}

    <div id="network-stage" class={`network__stage${hasError ? ' network__stage--error' : ''}`}>
      {hasError ? (
        <p class="network__error">Network unavailable — check back soon.</p>
      ) : (
        <div id="network-container" class="network__canvas">
          <p class="network__loading">Loading network...</p>
        </div>
      )}

      <nav class="network__periods network__overlay network__overlay--tr" aria-label="Time period filter">
        {VALID_PERIODS.map((p) => (
          <a
            href={`?period=${p}`}
            class={`network__period-btn${p === period ? ' network__period-btn--active' : ''}`}
          >
            {periodLabels[p]}
          </a>
        ))}
      </nav>

      <section id="network-panel" class="network__panel network__overlay network__overlay--tl" aria-label="Graph controls">
        <div class="network__panel-head">
          <button
            type="button"
            id="ctrl-panel-toggle"
            class="network__panel-toggle"
            aria-expanded="true"
            aria-controls="network-panel-body"
          >
            Filters <span id="ctrl-active-count" class="network__panel-count" hidden></span>
            <span class="network__panel-caret" aria-hidden="true">▾</span>
          </button>
          <button type="button" id="ctrl-clear" class="network__panel-clear" hidden>clear</button>
        </div>
        <div id="network-panel-body" class="network__controls">
          <input
            id="ctrl-search"
            class="network__control network__control--input"
            type="text"
            placeholder="search artists"
            autocomplete="off"
            aria-label="Search artists by name"
          />
          <select id="ctrl-genre-filter" class="network__control" aria-label="Filter by tag">
            <option value="">all tags</option>
          </select>
          <label class="network__slider" id="ctrl-threshold-label">
            <span id="ctrl-threshold-text" class="network__slider-text">min similarity: 0.0</span>
            <input
              id="ctrl-threshold"
              type="range"
              min="0" max="1" step="0.1" value="0"
              aria-label="Similarity threshold"
              aria-valuetext="0.0"
            />
            <span id="ctrl-link-count" class="network__slider-count" aria-live="polite"></span>
          </label>
        </div>
      </section>

      <div class="network__tools network__overlay network__overlay--bl">
        <button id="ctrl-genre" class="network__control" aria-pressed="false">cluster by genre</button>
        <button id="ctrl-fullscreen" class="network__control" aria-pressed="false">⤢ fullscreen</button>
      </div>

      {!hasError && (
        <ul class="network__legend network__overlay network__overlay--br" aria-label="Genre colour key">
          {legendFamilies.map((family) => (
            <li>
              <button
                type="button"
                class="network__legend-item"
                data-genre-family={genreFamilySlug(family)}
                aria-pressed="false"
              >
                <span
                  class={`network__legend-swatch network__legend-swatch--${genreFamilySlug(family)}`}
                  aria-hidden="true"
                />
                <span class="network__legend-label">{family}</span>
                <span class="network__legend-count" data-genre-family={genreFamilySlug(family)} />
              </button>
            </li>
          ))}
          {ghostData.nodes.length > 0 && (
            <li class="network__legend-note">
              <span class="network__legend-ghost-swatch" aria-hidden="true" />
              outside influence {ghostData.nodes.length}
            </li>
          )}
        </ul>
      )}
    </div>
  </section>

  {!hasError && (
    <script id="graph-data" type="application/json" set:html={JSON.stringify(graphData).replace(/<\//g, '<\\/')} />
  )}

  {!hasError && (
    <script id="ghost-data" type="application/json"
      set:html={JSON.stringify(ghostData).replace(/<\//g, '<\\/')} />
  )}

  {!hasError && (
    <script id="all-tags-data" type="application/json"
      set:html={JSON.stringify(uniqueTags).replace(/<\//g, '<\\/')} />
  )}

  {!hasError && (
    <script id="node-tags-data" type="application/json"
      set:html={JSON.stringify(nodeTagsMap).replace(/<\//g, '<\\/')} />
  )}

  {!hasError && (
    <script id="node-chronology-data" type="application/json"
      set:html={JSON.stringify(nodeChronologyMap).replace(/<\//g, '<\\/')} />
  )}

  {networkChangelog.length > 0 && (
    <section class="network__changelog-section container">
      <details class="network__changelog">
        <summary class="network__changelog-summary">
          changelog
          <span class="network__changelog-count">{networkChangelog.length} {networkChangelog.length === 1 ? 'update' : 'updates'}</span>
          <span class="network__changelog-arrow" aria-hidden="true">▸</span>
        </summary>
        <ol class="network__changelog-list">
          {networkChangelog.map((entry) => (
            <li class="network__changelog-entry">
              <time class="network__changelog-date" datetime={entry.date}>
                {formatDate(entry.date)}
              </time>
              <ul class="network__changelog-items">
                {entry.items.map((item) => (
                  <li class="network__changelog-item">
                    <span class={`network__changelog-label network__changelog-label--${item.label}`}>
                      {item.label}
                    </span>
                    {item.text}
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ol>
      </details>
    </section>
  )}
</BaseLayout>

<style>
  .network {
    padding-top: var(--space-2xl);
    padding-bottom: var(--space-xl);

    /* STC-339 genre palette. Declared here rather than in global.css because
       nothing else on the site colours by genre, and set on .network (not the
       canvas) so the legend swatches and the D3-built SVG nodes inherit the
       same values.

       Eight hues, searched rather than borrowed. A force layout can put any two
       nodes next to each other, which is the strict "all-pairs" case for a
       categorical palette -- far harder than the "adjacent-pairs" case a stock
       palette is tuned for. The data-viz reference palette's eight scored a
       worst all-pairs normal-vision dE of 7.1 and CVD 3.2 against this page's
       surfaces, both hard failures. These eight were found by searching OKLCH
       for the set maximising worst-case all-pairs separation inside each mode's
       lightness band, and score, against #f8f8f8 / #18181C:

         light  normal dE 14.4  |  CVD dE 7.6  |  lightness + chroma PASS
         dark   normal dE 13.3  |  CVD dE 6.4  |  lightness + chroma + 3:1 PASS

       Roughly double the separation of the stock eight, and CVD moves from a
       hard failure into the 6-8 band, which is permitted with secondary
       encoding. Both modes still land just under the 15.0 normal-vision floor:
       eight hues cannot clear it in dark mode, whose lightness band (0.48-0.67)
       is barely half of light's (0.43-0.77), so eight colours must separate by
       hue alone there and the OKLCH hue circle is not big enough at achievable
       chroma. Three hues clear every floor outright; eight is a deliberate
       trade of strict separation for granularity.

       What carries identity when two hues are close: every node is labelled
       with its artist name, and the legend is interactive -- clicking a family
       isolates it, so any "which family is this?" question is answerable
       without discriminating hues by eye. That is also the relief the checker
       requires for the light-mode contrast warning (three slots sit under 3:1
       on the light surface).

       Dark values are the same eight hue angles re-stepped for the dark
       surface, not an automatic flip, so a family keeps its identity across
       themes. Slot order is fixed and matches GENRE_FAMILIES: colour follows
       the family, never its node count. See src/lib/genre-families.ts. */
    --genre-electronic: #26ccd1;
    --genre-rock: #a9525f;
    --genre-metal: #737000;
    --genre-punk: #504cef;
    --genre-indie: #6e3673;
    --genre-hip-hop: #d7861e;
    --genre-soul-funk: #48a16e;
    --genre-jazz-blues: #007baa;
    --genre-other: var(--color-on-surface);
  }
  :root[data-theme="dark"] .network {
    --genre-electronic: #03999d;
    --genre-rock: #c1405a;
    --genre-metal: #969442;
    --genre-punk: #4f52db;
    --genre-indie: #c056ca;
    --genre-hip-hop: #955903;
    --genre-soul-funk: #227549;
    --genre-jazz-blues: #006c96;
  }

  .network__legend li {
    display: contents;
  }
  .network__legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-md);
    list-style: none;
    margin: 0 0 var(--space-md);
    padding: 0;
    font-size: var(--text-body-medium);
    color: var(--color-on-surface-dimmed);
  }
  /* Two classes: `.network__legend li` is display:contents and would win. */
  .network__legend .network__legend-note {
    display: flex;
    white-space: nowrap;
    align-items: center;
    gap: var(--space-2xs);
    padding: 2px 6px;
  }
  /* Dashed hollow ring: the same encoding the ghost nodes use on the canvas. */
  .network__legend-ghost-swatch {
    flex: none;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 1px dashed var(--color-on-surface-dimmed);
  }
  .network__legend-item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    /* Reset the UA button box -- this reads as a label, not a control, until
       hovered or pressed. */
    background: none;
    border: 1px solid transparent;
    border-radius: 2px;
    padding: 2px 6px;
    margin: 0;
    font: inherit;
    color: inherit;
    cursor: pointer;
  }
  .network__legend-item:hover {
    border-color: var(--color-border);
    color: var(--color-on-surface);
  }
  .network__legend-item:focus-visible {
    outline: 2px solid var(--color-on-surface);
    outline-offset: 1px;
  }
  .network__legend-item[aria-pressed='true'] {
    border-color: var(--color-on-surface);
    color: var(--color-on-surface);
  }
  .network__legend-swatch {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
    /* Identity is never colour-alone: the swatch sits beside a text label. */
    background-color: var(--genre-other);
    opacity: 0.95; /* matches FULL_NODE_OPACITY on the nodes themselves */
  }
  .network__legend-swatch--electronic { background-color: var(--genre-electronic); }
  .network__legend-swatch--rock { background-color: var(--genre-rock); }
  .network__legend-swatch--metal { background-color: var(--genre-metal); }
  .network__legend-swatch--punk { background-color: var(--genre-punk); }
  .network__legend-swatch--indie { background-color: var(--genre-indie); }
  .network__legend-swatch--hip-hop { background-color: var(--genre-hip-hop); }
  .network__legend-swatch--soul-funk { background-color: var(--genre-soul-funk); }
  .network__legend-swatch--jazz-blues { background-color: var(--genre-jazz-blues); }
  .network__legend-count {
    color: var(--color-on-surface-muted);
    font-variant-numeric: tabular-nums;
  }
  .network__legend-count:empty {
    display: none;
  }
  .network__heading {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-display-large);
    line-height: var(--lh-display-large);
    margin-bottom: var(--space-md);
  }
  .network__meta {
    font-size: var(--text-body-medium);
    color: var(--color-on-surface-dimmed);
    margin-bottom: var(--space-lg);
  }
  .network__stale-banner {
    font-size: var(--text-body-medium);
    color: var(--color-on-surface-dimmed);
    margin-bottom: var(--space-lg);
  }
  /* ── Stage: the canvas plus the controls floating over it ── */
  .network__stage {
    position: relative;
    margin-bottom: var(--space-lg);
    /* Everything inside the network window -- controls, key, graph labels and
       tooltips -- is set in Geist (open-licensed, loaded from Google Fonts in
       <head>), not the site's licensed Polymath. The site stack is the
       fallback while it loads or if it is blocked. */
    font-family: 'Geist', var(--font-body), system-ui, sans-serif;
  }
  .network__stage--error {
    min-height: 220px;
  }
  .network__stage .network__canvas {
    margin: 0;
  }
  .network__stage:fullscreen {
    background: var(--color-surface);
    margin: 0;
  }
  .network__stage:fullscreen .network__canvas {
    height: 100vh;
    min-height: 100vh;
    border: 0;
  }
  .network__overlay {
    position: absolute;
    z-index: 5;
    /* Translucent so the graph still reads through; the blur keeps small
       labels behind a panel from fighting the panel's own text. */
    background: color-mix(in srgb, var(--color-surface) 86%, transparent);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    border: 1px solid var(--color-border);
    border-radius: 2px;
  }
  .network__overlay--tl { top: 12px; left: 12px; }
  .network__overlay--tr { top: 12px; right: 12px; }
  .network__overlay--bl { bottom: 12px; left: 12px; }
  .network__overlay--br { bottom: 12px; right: 12px; }

  /* Period: one segmented control, top right. */
  .network__periods {
    display: inline-flex;
  }
  .network__period-btn {
    display: inline-block;
    padding: 4px 10px;
    font-size: var(--text-body-medium);
    color: var(--color-on-surface-dimmed);
    border-right: 1px solid var(--color-border);
  }
  .network__period-btn:last-child {
    border-right: 0;
  }
  .network__period-btn--active {
    background: var(--color-on-surface);
    color: var(--color-surface);
    font-weight: 700;
  }

  /* Filters panel, top left; collapses to its header. */
  .network__panel {
    width: 220px;
    max-width: calc(100% - 24px);
    padding: 8px;
  }
  .network__panel-head {

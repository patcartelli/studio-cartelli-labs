  }
  .network__canvas {
    width: 100%;
    min-height: 600px;
    position: relative;
    border: 1px solid var(--color-border);
    overflow: hidden;
  }
  .network__canvas svg {
    display: block;
    overflow: hidden;
    /* Required for d3.zoom to capture touch pan/pinch on mobile.
       Without this the browser claims the gesture for page scroll. */
    touch-action: none;
  }
  .network__loading {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-body-medium);
    color: var(--color-on-surface-dimmed);
  }

  /* ── Changelog ── */
  .network__changelog-section {
    padding-bottom: var(--space-xl);

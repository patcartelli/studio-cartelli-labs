    const artistSpan = document.createElement('span');
    artistSpan.className = 'text-row__artist';
    artistSpan.textContent = album.artist; // T-18-09: textContent only
    artistSpan.title = album.artist;
    primary.appendChild(artistSpan);

    li.appendChild(primary);

    // Plays group
    const playsGroup = document.createElement('div');
    playsGroup.className = 'text-row__plays-group';

    const playsLabel = document.createElement('span');
    playsLabel.className = 'text-row__plays-label';
    playsLabel.textContent = 'Plays';
    playsGroup.appendChild(playsLabel);

    const playsVal = document.createElement('span');
    playsVal.className = 'text-row__plays';
    playsVal.textContent = listFormatPlays(album.playcount); // abbreviated (D-14, T-18-09)
    playsGroup.appendChild(playsVal);

    li.appendChild(playsGroup);

    // Links — Phase 19: real last.fm link or disabled span fallback (D-06, REVL-01)
    const linksDiv = document.createElement('div');
    linksDiv.className = 'text-row__links';

    if (album.url) {
      const lfmA = document.createElement('a');
      lfmA.href = album.url;
      lfmA.target = '_blank';
      lfmA.rel = 'noopener noreferrer';
      lfmA.className = 'text-row__link';
      lfmA.setAttribute('aria-label', `Listen to ${album.name} by ${album.artist} on last.fm`);
      lfmA.textContent = 'last.fm';
      linksDiv.appendChild(lfmA);
    } else {
      const linkSpan = document.createElement('span');
      linkSpan.className = 'text-row__link text-row__link--disabled';
      linkSpan.setAttribute('aria-hidden', 'true');
      linkSpan.textContent = 'last.fm';
      linksDiv.appendChild(linkSpan);
    }
    // --- website link insertion point (Task 3 wires this after artist-website batch) ---

    li.appendChild(linksDiv);

    // Inline thumb — set src from raw CDN url (D-08; no proxy-image for plain <img>)
    const thumb = document.createElement('img');
    thumb.className = 'text-row__thumb';
    thumb.alt = '';
    thumb.width = 48;
    thumb.height = 48;
    if (album.imageUrl) thumb.src = album.imageUrl;
    li.appendChild(thumb);

    return li;
  }

  // createArtistRow — sibling fork of createTextRow for the artists load-more append path

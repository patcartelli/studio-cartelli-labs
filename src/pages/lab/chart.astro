  async function loadMoreChunk(view: string): Promise<void> {
    if (loadMoreInFlight) return;
    loadMoreInFlight = true;

    const listContainer = document.querySelector<HTMLElement>(`.chart-list[data-view="${view}"]`);
    if (!listContainer) { loadMoreInFlight = false; return; }

    const btn = listContainer.querySelector<HTMLButtonElement>('.chart-list__load-more');
    const endNote = listContainer.querySelector<HTMLElement>('.chart-list__end-note');
    const errorRegion = listContainer.querySelector<HTMLElement>('.chart-list__error');
    const errorMsg = listContainer.querySelector<HTMLElement>('.chart-list__error-msg');
    const ol = listContainer.querySelector<HTMLOListElement>('.text-list');
    if (!btn || !endNote || !errorRegion || !ol) { loadMoreInFlight = false; return; }

    // D-15: disabled + loading state while fetching
    btn.disabled = true;
    btn.setAttribute('aria-busy', 'true');
    btn.textContent = 'Loading…';
    // Clear any previous inline error (D-16)
    errorRegion.hidden = true;

    const offset = listOffsets[view] ?? 20;
    const url = `/api/chart-list?view=${encodeURIComponent(view)}&offset=${offset}&limit=20`;

    const controller = new AbortController();
    const timeoutId = setTimeout(() => controller.abort(), 10_000);

    try {
      const res = await fetch(url, { signal: controller.signal });
      clearTimeout(timeoutId);

      if (!res.ok) {
        // D-16: inline error + retry; already-loaded rows stay intact (Pitfall 1: view-accurate noun)
        if (errorMsg) errorMsg.textContent = `Failed to load more ${VIEW_NOUN[view] ?? 'items'} (${res.status}).`;
        errorRegion.hidden = false;
        btn.disabled = false;
        btn.removeAttribute('aria-busy');
        btn.textContent = 'Load more';
        loadMoreInFlight = false;
        return;
      }

      // Per-view row-builder dispatch (LIST-06/LIST-07) — albums keeps createTextRow unchanged.
      const data = await res.json() as ChartListResponse | ChartListArtistResponse | ChartListTrackResponse;

      // Append new rows — T-18-09: only textContent/setAttribute (via per-view row builder)
      if (view === 'artists') {
        const artistRows = (data as ChartListArtistResponse).rows;
        for (const row of artistRows) {
          ol.appendChild(createArtistRow(row));
        }
        // Batch-resolve thumb + fade-in + website link for the newly appended rows (REVL-08/09)
        await appendArtistExtras(ol, artistRows);
      } else if (view === 'tracks') {
        const trackRows = (data as ChartListTrackResponse).rows;
        for (const row of trackRows) {
          ol.appendChild(createTrackRow(row));
        }
        // Batch-resolve website link for the newly appended rows (REVL-09)
        await appendTrackWebsiteLinks(ol, trackRows);
      } else {
        const albumRows = (data as ChartListResponse).rows;
        for (const row of albumRows) {
          ol.appendChild(createTextRow(row));
        }
        // Wire website links for newly appended rows — albums (unchanged)
        await appendWebsiteLinks(ol, albumRows);
      }

      // Advance offset by actual rows appended (D-03)
      listOffsets[view] = offset + data.rows.length;

      // D-04/D-15: exhausted check
      if (!data.hasMore || data.rows.length < 20) {
        btn.hidden = true;
        endNote.hidden = false;
      } else {
        // Re-enable for next click
        btn.disabled = false;
        btn.removeAttribute('aria-busy');
        btn.textContent = 'Load more';
      }
    } catch (err) {
      clearTimeout(timeoutId);
      // D-16: show inline error; keep loaded rows; retry refetches same offset
      if (errorMsg) {
        errorMsg.textContent = (err instanceof Error && err.name === 'AbortError')
          ? 'Request timed out.'
          : `Failed to load more ${VIEW_NOUN[view] ?? 'items'}.`;
      }
      errorRegion.hidden = false;
      btn.disabled = false;
      btn.removeAttribute('aria-busy');
      btn.textContent = 'Load more';
    } finally {
      loadMoreInFlight = false;
    }
  }

  // Attach Load-more and Retry click handlers for each chart-list container.
  // Each container's buttons route to that container's OWN view (D-12 tab-ready),
  // not the global activeViewName — a saved non-albums tab must not dead-end the
  // albums Load-more (CR-01). Today only the albums list exists.
  document.querySelectorAll<HTMLElement>('.chart-list[data-view]').forEach((container) => {
    const view = container.dataset.view;
    if (!view) return;

    const loadMoreBtn = container.querySelector<HTMLButtonElement>('.chart-list__load-more');
    if (loadMoreBtn) {
      loadMoreBtn.addEventListener('click', () => {
        loadMoreChunk(view);
      });
    }

    // Wire retry button once at init — T-18-11: refetches the SAME offset (no advance).
    // WR-01: the error region is shared between the initial-load and load-more paths, so
    // Retry dispatches on per-view load state — while the view's initial load has not yet
    // succeeded it re-issues the initial fetch (offset 0) exactly once per click; only
    // after a successful initial fill does it route to loadMoreChunk. Never both at once.
    const retryBtn = container.querySelector<HTMLButtonElement>('.chart-list__retry');
    if (retryBtn) {
      retryBtn.addEventListener('click', () => {
        if (initialLoadFailed.has(view)) {
          loadInitialListData(view);
        } else {
          loadMoreChunk(view);
        }
      });
    }
  });

  // ---- Text-reveal engine (Phase 19 — REVL-03/04/05/06) ----
  // Cursor-anchored floating cover-art overlay on hover-capable devices. Event delegation
  // via rAF + elementFromPoint so load-more rows reveal without per-row re-binding (D-07).
  // Reduced-motion: short-circuit — overlay never created, no listeners attached (REVL-06).
  // No-hover (touch): short-circuit — inline 48px thumb handles art reveal (REVL-04).
  (() => {
    const section = document.querySelector<HTMLElement>('.chart-list-section');
    if (!section) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

    if (reduced || !canHover) {
      // Reduced motion → CSS :hover fallback covers row text-color shift.
      // No-hover (touch) → inline thumb in markup handles art reveal.
      return;
    }

    const overlay = document.createElement('img');
    overlay.className = 'text-reveal-overlay';
    overlay.setAttribute('aria-hidden', 'true');
    overlay.alt = '';
    document.body.appendChild(overlay);

    let lastX = 0;
    let lastY = 0;
    let ticking = false;
    let activeRow: HTMLLIElement | null = null;
    let focusedRow: HTMLLIElement | null = null;
    let currentSrc = '';

    const OVERLAY_SIZE = 320;
    const OVERLAY_OFFSET_X = 24;
    const OVERLAY_OFFSET_Y = -280;
    const EDGE_PADDING = 16;

    function findCursorRow(): HTMLLIElement | null {
      const el = document.elementFromPoint(lastX, lastY) as HTMLElement | null;
      if (!el) return null;
      const row = el.closest('.text-row') as HTMLLIElement | null;
      return row && section?.contains(row) ? row : null;
    }

    function setActive(row: HTMLLIElement | null): void {
      if (row === activeRow) return;
      if (activeRow) activeRow.removeAttribute('data-active');
      activeRow = row;
      if (row) row.setAttribute('data-active', 'true');

      // Update overlay src/visibility
      const img = row?.dataset.image ?? '';
      if (img && img !== currentSrc) {
        overlay.src = img;
        currentSrc = img;
      }
      if (row && img) {
        overlay.setAttribute('data-visible', 'true');
      } else {
        overlay.removeAttribute('data-visible');
      }
    }

    function positionOverlay(): void {
      if (!activeRow) return;
      let x: number;
      let y: number;
      if (focusedRow) {
        // Fixed top-right for focus-driven reveal (no cursor to anchor to)
        x = window.innerWidth - OVERLAY_SIZE - 24;
        y = 24;
      } else {
        // Cursor-anchored with right + up offset, clamped to viewport
        const rawX = lastX + OVERLAY_OFFSET_X;
        const rawY = lastY + OVERLAY_OFFSET_Y;
        const maxX = window.innerWidth - OVERLAY_SIZE - EDGE_PADDING;
        const maxY = window.innerHeight - OVERLAY_SIZE - EDGE_PADDING;
        x = Math.max(EDGE_PADDING, Math.min(maxX, rawX));
        y = Math.max(EDGE_PADDING, Math.min(maxY, rawY));
      }
      overlay.style.transform = `translate(${x}px, ${y}px)`;
    }

    function update(): void {
      ticking = false;
      const target = focusedRow ?? findCursorRow();
      setActive(target);
      positionOverlay();
    }

    function schedule(): void {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }

    function onMouseMove(e: MouseEvent): void {
      lastX = e.clientX;
      lastY = e.clientY;
      schedule();
    }

    function onScroll(): void {
      schedule();
    }

    function onMouseLeave(): void {
      if (focusedRow) return; // keep focus state visible even if cursor leaves
      setActive(null);
    }

    function onFocusIn(e: FocusEvent): void {
      const target = e.target as HTMLElement | null;
      const link = target?.closest('.text-row__link') as HTMLAnchorElement | null;
      if (!link) return;
      const row = link.closest('.text-row') as HTMLLIElement | null;
      if (row && section?.contains(row)) {
        focusedRow = row;
        schedule();
      }
    }

    function onFocusOut(e: FocusEvent): void {
      const next = e.relatedTarget as HTMLElement | null;
      if (next && next.closest('.text-row__link')) {
        // Focus moving to another link in the list — let focusin handle it
        return;
      }
      focusedRow = null;
      setActive(null);
    }

    section.addEventListener('mousemove', onMouseMove, { passive: true });
    document.addEventListener('scroll', onScroll, { passive: true });
    section.addEventListener('mouseleave', onMouseLeave);
    section.addEventListener('focusin', onFocusIn);
    section.addEventListener('focusout', onFocusOut);
  })();

  // ---- Lazy image shimmer removal ----
  document.querySelectorAll<HTMLImageElement>('.chart__tile img[loading="lazy"]').forEach(img => {
    const tile = img.closest('.chart__tile');
    if (!tile) return;
    if (img.complete) {
      tile.classList.remove('chart__shimmer');
    } else {
      img.addEventListener('load', () => {
        tile.classList.remove('chart__shimmer');
      }, { once: true });
    }
  });

  document.querySelectorAll<HTMLImageElement>('.chart__thumb-wrap img[loading="lazy"]').forEach(img => {
    const wrap = img.closest('.chart__thumb-wrap');
    if (!wrap) return;
    if (img.complete) {
      wrap.classList.remove('chart__shimmer');
    } else {
      img.addEventListener('load', () => {
        wrap.classList.remove('chart__shimmer');
      }, { once: true });
    }
  });
</script>

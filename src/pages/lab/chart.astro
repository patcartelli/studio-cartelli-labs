    padding: var(--space-xs) 0;
  }

  .chart-list__error {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--text-body-small);
  }

  /* Rule 1 fix (Phase 23 Plan 04): the `[hidden]` UA style and the class rule above have
     equal specificity, and author CSS always wins over UA default styles regardless of
     source order — so `display: flex` above was unconditionally overriding the `hidden`
     attribute, making the error/Retry UI visibly render on every page load, not just on
     failure. This restores `hidden` as authoritative. */
  .chart-list__error[hidden] {
    display: none;
  }

  .chart-list__error-msg {
    font-family: var(--font-body);
    color: var(--color-on-surface-dimmed);
  }

  .chart-list__retry {
    font-family: var(--font-body);
    font-size: var(--text-body-small);
    color: var(--color-on-surface-muted);
    background: none;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: 3px 10px;
    cursor: pointer;
    letter-spacing: 0.01em;
    transition: color 120ms ease, border-color 120ms ease;
  }

  .chart-list__retry:hover {
    color: var(--color-on-surface);
    border-color: var(--color-on-surface-dimmed);
  }

  @media (prefers-reduced-motion: reduce) {
    .chart-list__load-more,
    .chart-list__retry {
      transition: none;
    }
  }
</style>

<script>
  declare global {
    interface Window {
      cloudflare?: {
        beacon?: {
          event?: (name: string, data?: Record<string, unknown>) => void;
        };
      };
    }
  }

  const STORAGE_LABELS_KEY = 'chart-labels';
  const STORAGE_VIEW_KEY = 'chart-view';

  // ---- View switching ----
  const viewLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.chart__view-link'));
  const viewToggleLabel = document.querySelector<HTMLLabelElement>('.chart__toggle');
  const copyBtn = document.querySelector<HTMLButtonElement>('.chart__copy-btn');
  const toggleInput = document.querySelector<HTMLInputElement>('.chart__toggle-input');

  // WR-03: validate the persisted view against the whitelist at read time — a stale,
  // legacy, or hand-edited value would otherwise hide every .chart__view/.chart-list
  // container AND route the lazy loader into the albums fallback branch, double-running
  // appendWebsiteLinks against the albums <ol> (duplicate "· website" links).
  const VALID_VIEWS = ['albums', 'artists', 'tracks'];
  const storedView = localStorage.getItem(STORAGE_VIEW_KEY);
  let activeViewName = storedView && VALID_VIEWS.includes(storedView) ? storedView : 'albums';

  // LIST-05/D-02/D-04: albums is eager-filled by the existing initial-fill IIFE below;
  // artists/tracks lazily fetch on their FIRST activation only (loadInitialListData
  // is a hoisted `function` declared later in this script — see hoisting note there).
  const loadedViews = new Set<string>(['albums']);

  // WR-01: views whose INITIAL lazy load has failed. The per-container Retry button is
  // shared between the initial-load and load-more error paths, so its single init-time
  // listener dispatches on this set — re-issuing the initial fetch (offset 0) while the
  // view is marked failed, and only routing back to loadMoreChunk after a success clears it.
  const initialLoadFailed = new Set<string>();

  // WR-01 (Phase 23 review): per-view in-flight guard for loadInitialListData. A
  // double-clicked Retry, or switching away and back while a retry is in flight
  // (loadedViews is only re-added on success), would otherwise run the non-idempotent
  // batch resolvers concurrently and append duplicate "· website" links.
  const initialLoadInFlight = new Set<string>();

  function getActiveGrid(): HTMLDivElement | null {
    return document.querySelector<HTMLDivElement>(
      `.chart__view[data-view="${activeViewName}"] .chart__grid`
    );
  }

  function activateView(viewName: string) {
    activeViewName = viewName;

    document.querySelectorAll<HTMLDivElement>('.chart__view').forEach((view) => {
      view.style.display = view.dataset.view === viewName ? '' : 'none';
    });

    viewLinks.forEach((link) => {
      link.classList.toggle('chart__view-link--active', link.dataset.for === viewName);
    });

    const isArtists = viewName === 'artists';
    if (viewToggleLabel) viewToggleLabel.style.display = isArtists ? 'none' : '';
    if (copyBtn) copyBtn.style.display = isArtists ? 'none' : '';

    // D-01: real per-container list switching, replaces the removed hide-guard —
    // the Weekly list now follows the active view instead of hiding on non-albums views.
    document.querySelectorAll<HTMLElement>('.chart-list[data-view]').forEach((container) => {
      container.style.display = container.dataset.view === viewName ? '' : 'none';
    });

    // D-02/D-04: lazy fetch on FIRST activation only; re-switching to an already-loaded
    // view keeps its rows (no refetch, no reset).
    if (!loadedViews.has(viewName)) {
      loadedViews.add(viewName);
      loadInitialListData(viewName);
    }

    // Re-apply labels to active grid
    if (toggleInput && !isArtists) {
      getActiveGrid()?.classList.toggle('chart__grid--labels', toggleInput.checked);
    }

    localStorage.setItem(STORAGE_VIEW_KEY, viewName);
  }

  // Initialize
  activateView(activeViewName);

  // Apply saved labels state to initial active grid
  if (toggleInput && localStorage.getItem(STORAGE_LABELS_KEY) === '1') {
    toggleInput.checked = true;
    getActiveGrid()?.classList.add('chart__grid--labels');
  }

  viewLinks.forEach((link) => {
    link.addEventListener('click', () => {
      activateView(link.dataset.for ?? 'albums');
    });
    link.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        activateView(link.dataset.for ?? 'albums');
      }
    });
  });

  // ---- Labels toggle ----
  if (toggleInput) {
    toggleInput.addEventListener('change', () => {
      const on = toggleInput.checked;
      getActiveGrid()?.classList.toggle('chart__grid--labels', on);
      localStorage.setItem(STORAGE_LABELS_KEY, on ? '1' : '0');
    });
  }

  // ---- Copy ----
  if (copyBtn) {
    async function buildChartBlob(grid: HTMLElement): Promise<Blob> {
      // COPY-01: bounded async — per-tile load/decode (1.5s) absorbs transient slowness
      // via gray-cell fallback; overall (5s) ensures cascade fall-through within Phase 13
      // modal-tier wait ceiling.
      const TILE_PRELOAD_TIMEOUT_MS = 1500;
      const BUILD_BLOB_TIMEOUT_MS = 5000;

      // WR-01/WR-03/IN-02: centralize the race-plus-timer pattern so the
      // `clearTimeout` on the winning branch is impossible to forget. Without
      // this, the loser-side timer keeps the closure + Error allocation alive
      // until it ticks — up to ~25 dangling per copy click at the per-tile
      // layer plus one per buildChartBlob call at the outer layer.
      const withTimeout = <T,>(p: Promise<T>, ms: number, msg: string): Promise<T> => {
        let id: ReturnType<typeof setTimeout> | undefined;
        const timeout = new Promise<never>((_, reject) => {
          id = setTimeout(() => reject(new Error(msg)), ms);
        });
        return Promise.race([p, timeout]).finally(() => {
          if (id !== undefined) clearTimeout(id);
        });
      };

      const build = async (): Promise<Blob> => {
        const labelsOn = grid.classList.contains('chart__grid--labels');
        const tiles = Array.from(grid.querySelectorAll<HTMLDivElement>('.chart__tile'));

        const TILE_SIZE = 300;
        const COLS = 4;
        const ROWS = Math.ceil(tiles.length / COLS);
        const canvas = document.createElement('canvas');
        canvas.width = TILE_SIZE * COLS;
        canvas.height = TILE_SIZE * ROWS;
        const ctx = canvas.getContext('2d');
        if (!ctx) throw new Error('Could not get 2D canvas context');

        const [imageData] = await Promise.all([
          Promise.all(
            tiles.map(async (tile, tileIndex) => {
              const img = tile.querySelector('img');
              const artist = tile.querySelector('.chart__overlay-artist')?.textContent ?? '';
              const album = tile.querySelector('.chart__overlay-album')?.textContent ?? '';
              let drawable: HTMLImageElement | null = null;
              if (img) {
                if (img.complete) {
                  drawable = img;
                } else {
                  // WR-02: hoist `cleanup` so it is reachable from the OUTER
                  // try/finally. The inner promise's natural `{ once: true }`
                  // removal only fires when load/error actually dispatches —
                  // if the timer wins the race, the listeners would otherwise
                  // stay attached to the DOM <img> and fire on the eventual
                  // lazy fetch, accumulating across copy clicks. The outer
                  // `finally` here runs on EVERY branch (success, load error,
                  // per-tile timeout, decode reject) so the listeners are
                  // always detached.
                  let cleanup: () => void = () => {};
                  try {
                    // D-03: mutate DOM img in place — browser dedupes in-flight request
                    // against the existing src (COPY-02: zero new per-tile fetches).
                    img.loading = 'eager';
                    img.fetchPriority = 'high';
                    const loadPromise = new Promise<void>((resolve, reject) => {
                      const onLoad = () => resolve();
                      const onError = () => reject(new Error('img load error'));
                      cleanup = () => {
                        img.removeEventListener('load', onLoad);
                        img.removeEventListener('error', onError);
                      };
                      img.addEventListener('load', onLoad, { once: true });
                      img.addEventListener('error', onError, { once: true });
                    });
                    await withTimeout(loadPromise, TILE_PRELOAD_TIMEOUT_MS, 'tile load timeout');
                    await img.decode();
                    drawable = img;
                  } catch (err) {
                    // per-tile timeout or load error or decode reject — fall through to gray cell below (D-05)
                    console.warn('[chart] tile preload skipped', tileIndex, err);
                  } finally {
                    // WR-02: detach listeners on EVERY branch. `{ once: true }`
                    // only auto-removes on dispatch; if the timer won the race,
                    // neither onLoad nor onError fired and the handlers would
                    // otherwise leak onto the live DOM <img>.
                    cleanup();
                  }
                }
              }
              return { img: drawable, artist, album };
            })
          ),
          labelsOn
            ? Promise.all([
                document.fonts.load('600 10px "DM Sans"'),
                document.fonts.load('400 9px "DM Sans"'),
              ])
            : Promise.resolve(),
        ]);

        imageData.forEach(({ img, artist, album }, i) => {
          const col = i % COLS;
          const row = Math.floor(i / COLS);
          const x = col * TILE_SIZE;
          const y = row * TILE_SIZE;

          if (img) {
            ctx.drawImage(img, x, y, TILE_SIZE, TILE_SIZE);
          } else {
            ctx.fillStyle = '#e5e5e5';
            ctx.fillRect(x, y, TILE_SIZE, TILE_SIZE);
          }

          if (labelsOn) {
            const grad = ctx.createLinearGradient(0, y + TILE_SIZE, 0, y + TILE_SIZE - 90);
            grad.addColorStop(0, 'rgba(0,0,0,0.72)');
            grad.addColorStop(1, 'rgba(0,0,0,0)');
            ctx.fillStyle = grad;
            ctx.fillRect(x, y, TILE_SIZE, TILE_SIZE);

            ctx.fillStyle = '#ffffff';
            ctx.font = '600 10px "DM Sans", sans-serif';
            ctx.fillText(artist, x + 8, y + TILE_SIZE - 16, TILE_SIZE - 16);

            ctx.fillStyle = 'rgba(255,255,255,0.75)';
            ctx.font = '400 9px "DM Sans", sans-serif';
            ctx.fillText(album, x + 8, y + TILE_SIZE - 5, TILE_SIZE - 16);
          }
        });

        return new Promise<Blob>((resolve, reject) =>
          canvas.toBlob(
            (b) => (b ? resolve(b) : reject(new Error('toBlob returned null'))),
            'image/png'
          )
        );
      };

      return withTimeout(build(), BUILD_BLOB_TIMEOUT_MS, 'buildChartBlob timeout');
    }

    type CopyEvent = 'copy-success' | 'copy-shared' | 'copy-cancelled' | 'copy-modal' | 'copy-failed';

    function track(event: CopyEvent): void {
      if (import.meta.env.DEV) {
        console.debug('[chart-telemetry]', event);
      }
      try {
        const maybePromise = window.cloudflare?.beacon?.event?.(event);
        // D-01R / WR-01: the runtime symbol doesn't exist today and the API
        // shape is unknown. If a future CF event() returns a Promise (or
        // thenable), swallow rejections so they cannot escape as unhandled
        // promise rejections. D-06: telemetry never breaks the cascade.
        if (maybePromise && typeof (maybePromise as Promise<unknown>).then === 'function') {
          (maybePromise as Promise<unknown>).catch(() => {
            // D-06: telemetry never breaks the cascade.
          });
        }
      } catch {
        // D-06: telemetry never breaks the cascade.
      }
    }

    function finish(label: string) {
      copyBtn!.textContent = label;
      copyBtn!.disabled = false;
      setTimeout(() => {
        if (copyBtn!.textContent !== 'copy chart') {
          copyBtn!.textContent = 'copy chart';
        }
      }, 2000);
    }

    // ---- Modal handlers (× close button + backdrop click) ----
    // Escape dismissal and return-focus are native <dialog>.showModal() behaviors
    // and do not require JS. Backdrop tap requires an explicit click listener
    // (the `cancel` event fires only on Escape, NOT on backdrop tap) — see
    // 13-RESEARCH.md §2 for the iOS Safari-confirmed pattern.
    const modalCloseBtn = document.querySelector<HTMLButtonElement>('.chart__copy-modal-close');
    modalCloseBtn?.addEventListener('click', () => {
      const modal = document.getElementById('chart-copy-modal') as HTMLDialogElement | null;
      modal?.close();
    });

    const modalEl = document.getElementById('chart-copy-modal') as HTMLDialogElement | null;
    modalEl?.addEventListener('click', (e) => {
      if (e.target === modalEl) modalEl.close();
    });

    copyBtn.addEventListener('click', async () => {
      const grid = getActiveGrid();
      if (!grid) return;

      copyBtn.disabled = true;
      copyBtn.textContent = 'copying…';

      // 1. Clipboard — pass the unawaited buildChartBlob(grid) Promise into
      //    ClipboardItem so iOS Safari 16.4+ sees a synchronous call chain
      //    from the user gesture through navigator.clipboard.write. All
      //    canvas work (decode, drawImage, toBlob) runs inside the Promise.
      if (typeof ClipboardItem !== 'undefined' && navigator.clipboard?.write) {
        try {
          await navigator.clipboard.write([new ClipboardItem({ 'image/png': buildChartBlob(grid) })]);
          finish('copied!');
          track('copy-success');
          return;
        } catch (err) {
          console.warn('[chart] clipboard write failed, trying share:', err);
        }
      }

      // Materialize the blob for Web Share + modal tiers. If the Promise
      // rejects here (canvas context unavailable, toBlob null, decode
      // catastrophe), finish('failed') and bail — no share, no last-resort.
      let blob: Blob;
      try {
        blob = await buildChartBlob(grid);
      } catch (err) {
        console.error('[chart] image build failed:', err);
        finish('failed');
        track('copy-failed');
        return;
      }

      // 2. Web Share API — iOS 15+, Android Chrome.
      const file = new File([blob], 'chart.png', { type: 'image/png' });
      if (navigator.canShare?.({ files: [file] })) {
        try {
          await navigator.share({ files: [file], title: 'chart' });
          finish('shared!');
          track('copy-shared');
          return;
        } catch (err) {
          if ((err as Error).name === 'AbortError') {
            finish('copy chart');
            track('copy-cancelled');
            return;
          }
          console.warn('[chart] share failed, showing modal:', err);
        }
      }

      // 3. Last resort: in-page modal with long-press save hint.
      const modal = document.getElementById('chart-copy-modal') as HTMLDialogElement | null;
      const modalImg = modal?.querySelector<HTMLImageElement>('.chart__copy-modal-img');
      if (modal && modalImg && !modal.open) {
        const url = URL.createObjectURL(blob);
        modalImg.src = url;
        modal.addEventListener('close', () => URL.revokeObjectURL(url), { once: true });
        modal.showModal();
        finish('tap to save');
        track('copy-modal');
        console.warn('[chart] modal shown — clipboard and share unavailable');
      } else if (modal && modalImg && modal.open) {
        // Modal already open — second tap during open state; do nothing destructive.
        // finish() runs to clear the 'copying…' state honestly.
        finish('tap to save');
        track('copy-modal');
      } else {
        // Modal element missing from DOM — SSR regression, true failure state.
        finish('failed');
        track('copy-failed');
        console.error('[chart] modal element missing from DOM — cannot fall back');
      }
    });
  }

  // ---- Progressive fill ----
  type LatestRelease = { coverUrl: string; title: string; date?: string };

  type ChartArtist = {
    name: string;
    mbid: string;
    url: string;
    imageUrl: string;
    glowColor?: string;
    latestRelease: LatestRelease | null;
  };

  type ChartAlbum = {
    rank: number;
    name: string;
    artist: string;
    playcount: number;
    imageUrl: string;
    listenUrl: string | null;
  };

  type ChartTrack = {
    rank: number;
    name: string;
    artist: string;
    playcount: number;
    imageUrl: string;
    listenUrl: string | null;
  };

  type ChartDataResponse = {
    fetchedAt: number;
    albums: ChartAlbum[];
    tracks: ChartTrack[];
    artists: ChartArtist[];
  };

  type ArtistMap = Map<string, ChartArtist>;

  function fallbackAll() {
    const allHide = Array.from(document.querySelectorAll<HTMLElement>(
      '.chart__tile--artist .chart__tile-placeholder'
    ));

    allHide.forEach(el => el.classList.add('chart__hide-on-timeout'));

    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      allHide.forEach(el => { el.style.display = 'none'; });
    } else {
      setTimeout(() => {
        allHide.forEach(el => { el.style.display = 'none'; });
      }, 350);
    }
  }

  function fillArtistGridTiles(artistMap: ArtistMap) {
    document.querySelectorAll<HTMLElement>('.chart__tile--artist').forEach(tile => {
      const name = tile.dataset.artist?.toLowerCase() ?? '';
      const a = artistMap.get(name);
      // WR-07: third-party image URLs (Fanart.tv/Wikimedia/Deezer/TADB via /api/chart-data)
      // must pass an http(s) scheme check, and JSON.stringify escapes embedded quotes/
      // backslashes so a crafted value can't break out of the url() token and inject
      // arbitrary declarations into the inline style.
      if (a?.imageUrl && /^https?:\/\//i.test(a.imageUrl)) {
        tile.querySelector('.chart__tile-placeholder')?.remove();
        tile.style.backgroundImage = `url(${JSON.stringify(a.imageUrl)})`;
        tile.classList.add('has-photo');
      }
    });
  }

  // ---- Text list helpers ----

  function listFormatPlays(n: number): string {
    if (n >= 999_950) return `${(n / 1_000_000).toFixed(1)}M`;
    if (n >= 1_000) return `${(n / 1_000).toFixed(1)}k`;
    return String(n);
  }

  // Fill the initial 20 skeleton rows of the text list from the chart-data payload (D-05).
  // Uses textContent (not innerHTML) for all user-supplied strings — T-18-07 XSS mitigation.
  interface ChartListRow {
    rank: number;
    name: string;
    artist: string;
    playcount: number;
    imageUrl: string;
    url: string; // Last.fm permalink (raw getTopAlbums field) — NOT enrichment (REVL-01)
  }
  interface ChartListResponse {
    view: string;
    rows: ChartListRow[];
    offset: number;
    limit: number;
    total: number;
    hasMore: boolean;
  }

  function fillTextList(view: string, albums: ChartListRow[]): void {
    const ol = document.querySelector<HTMLOListElement>(
      `.chart-list[data-view="${view}"] .text-list`
    );
    if (!ol) return;

    const rows = Array.from(ol.querySelectorAll<HTMLLIElement>('.text-row'));

    // Remove surplus skeleton rows if API returned fewer albums than skeletons
    if (albums.length < rows.length) {
      rows.slice(albums.length).forEach(r => r.remove());
    }

    const count = Math.min(albums.length, rows.length);
    for (let i = 0; i < count; i++) {
      const row = rows[i];
      const album = albums[i];
      if (!row || !album) continue;

      // Set data-image for Phase 19 reveal engine (D-13)
      row.setAttribute('data-image', album.imageUrl ?? '');

      // Fill text via textContent — no innerHTML (T-18-07)
      const rankEl = row.querySelector<HTMLElement>('.text-row__rank');
      if (rankEl) {
        // WR-04: no aria-label — prohibited on a roleless span (axe aria-prohibited-attr,
        // see skeleton comment); visible rank text is read in DOM order, matching createTextRow.
        rankEl.textContent = String(album.rank); // full unpadded rank (D-14)
      }

      const albumEl = row.querySelector<HTMLElement>('.text-row__album');
      if (albumEl) {
        albumEl.textContent = album.name;
        albumEl.title = album.name;
      }

      const artistEl = row.querySelector<HTMLElement>('.text-row__artist');
      if (artistEl) {
        artistEl.textContent = album.artist;
        artistEl.title = album.artist;
      }

      const playsEl = row.querySelector<HTMLElement>('.text-row__plays');
      if (playsEl) {
        playsEl.textContent = listFormatPlays(album.playcount); // abbreviated (D-14)
      }

      // Wire last.fm link — replace disabled span with real anchor when url present (D-06, REVL-01)
      const linksDiv = row.querySelector<HTMLElement>('.text-row__links');
      if (linksDiv && album.url) {
        const existingSpan = linksDiv.querySelector('.text-row__link--disabled');
        if (existingSpan) {
          const a = document.createElement('a');
          a.href = album.url;
          a.target = '_blank';
          a.rel = 'noopener noreferrer';
          a.className = 'text-row__link';
          a.setAttribute('aria-label', `Listen to ${album.name} by ${album.artist} on last.fm`);
          a.textContent = 'last.fm';
          existingSpan.replaceWith(a);
        }
      }
      // If album.url is absent, the disabled span remains (D-06 fallback)

      // Set thumb src from raw CDN url (D-08; no proxy-image for plain <img> display)
      if (album.imageUrl) {
        const thumb = row.querySelector<HTMLImageElement>('.text-row__thumb');
        if (thumb) thumb.src = album.imageUrl;
      }

      // --- website link insertion point (Task 3 wires this after artist-website batch) ---
    }
  }

  // ---- Artists/tracks view row shapes (LIST-06/LIST-07) ----
  // Distinct from ChartListRow/ChartListResponse (albums) — artists carry no imageUrl/artist
  // field (D-06/D-10), tracks mirror the albums shape but keep the field names track/artist.
  interface ChartListArtistRow {
    rank: number;
    name: string;
    playcount: number;
    url: string;
  }
  interface ChartListTrackRow {
    rank: number;
    name: string;
    artist: string;
    playcount: number;
    imageUrl: string;
    url: string;
  }
  interface ChartListArtistResponse {
    view: string;
    rows: ChartListArtistRow[];
    offset: number;
    limit: number;
    total: number;
    hasMore: boolean;
  }
  interface ChartListTrackResponse {
    view: string;
    rows: ChartListTrackRow[];
    offset: number;
    limit: number;
    total: number;
    hasMore: boolean;
  }

  // fillArtistList — sibling fork of fillTextList for the artists view (D-08/D-06/D-01/D-09).
  // Artist rows carry rank | name, no separate artist field, plus a reserved 48px thumb
  // slot (D-01) that this function leaves unset — src wiring is Plan 03's batch-resolve scope.
  function fillArtistList(view: string, artists: ChartListArtistRow[]): void {
    const ol = document.querySelector<HTMLOListElement>(
      `.chart-list[data-view="${view}"] .text-list`
    );
    if (!ol) return;

    const rows = Array.from(ol.querySelectorAll<HTMLLIElement>('.text-row'));

    // Remove surplus skeleton rows if API returned fewer artists than skeletons
    if (artists.length < rows.length) {
      rows.slice(artists.length).forEach(r => r.remove());
    }

    const count = Math.min(artists.length, rows.length);
    for (let i = 0; i < count; i++) {
      const row = rows[i];
      const artist = artists[i];
      if (!row || !artist) continue;

      // No imageUrl at initial fill time (D-01/D-02) — the skeleton's reserved thumb
      // slot stays unset; the batch resolve (Plan 03) fills it in and updates data-image.
      row.setAttribute('data-image', '');

      const rankEl = row.querySelector<HTMLElement>('.text-row__rank');
      if (rankEl) {
        // WR-04: no aria-label — prohibited on a roleless span (axe aria-prohibited-attr,
        // see skeleton comment); visible rank text is read in DOM order, matching createArtistRow.
        rankEl.textContent = String(artist.rank);
      }

      const nameEl = row.querySelector<HTMLElement>('.text-row__name');
      if (nameEl) {
        nameEl.textContent = artist.name;
        nameEl.title = artist.name;
      }

      const playsEl = row.querySelector<HTMLElement>('.text-row__plays');
      if (playsEl) {
        playsEl.textContent = listFormatPlays(artist.playcount);
      }

      // Wire last.fm link — replace disabled span with real anchor when url present (D-09)
      const linksDiv = row.querySelector<HTMLElement>('.text-row__links');
      if (linksDiv && artist.url) {
        const existingSpan = linksDiv.querySelector('.text-row__link--disabled');
        if (existingSpan) {
          const a = document.createElement('a');
          a.href = artist.url;
          a.target = '_blank';
          a.rel = 'noopener noreferrer';
          a.className = 'text-row__link';
          a.setAttribute('aria-label', `Listen to ${artist.name} on last.fm`);
          a.textContent = 'last.fm';
          existingSpan.replaceWith(a);
        }
      }
      // The skeleton's reserved <img class="text-row__thumb"> slot (D-01) stays unset
      // here — src/--loaded wiring is Plan 03's batch-resolve scope.
    }
  }

  // fillTrackList — sibling fork of fillTextList for the tracks view (D-08/D-10/D-09).
  // Track rows carry rank | title — artist, plus the 48px thumb (D-10: tracks DO get a thumb).
  function fillTrackList(view: string, tracks: ChartListTrackRow[]): void {
    const ol = document.querySelector<HTMLOListElement>(
      `.chart-list[data-view="${view}"] .text-list`
    );
    if (!ol) return;

    const rows = Array.from(ol.querySelectorAll<HTMLLIElement>('.text-row'));

    // Remove surplus skeleton rows if API returned fewer tracks than skeletons
    if (tracks.length < rows.length) {
      rows.slice(tracks.length).forEach(r => r.remove());
    }

    const count = Math.min(tracks.length, rows.length);
    for (let i = 0; i < count; i++) {
      const row = rows[i];
      const track = tracks[i];
      if (!row || !track) continue;

      row.setAttribute('data-image', track.imageUrl ?? '');

      const rankEl = row.querySelector<HTMLElement>('.text-row__rank');
      if (rankEl) {
        // WR-04: no aria-label — prohibited on a roleless span (axe aria-prohibited-attr,
        // see skeleton comment); visible rank text is read in DOM order, matching createTrackRow.
        rankEl.textContent = String(track.rank);
      }

      const titleEl = row.querySelector<HTMLElement>('.text-row__track');
      if (titleEl) {
        titleEl.textContent = track.name;
        titleEl.title = track.name;
      }

      const artistEl = row.querySelector<HTMLElement>('.text-row__artist');
      if (artistEl) {
        artistEl.textContent = track.artist;
        artistEl.title = track.artist;
      }

      const playsEl = row.querySelector<HTMLElement>('.text-row__plays');
      if (playsEl) {
        playsEl.textContent = listFormatPlays(track.playcount);
      }

      // Wire last.fm link — replace disabled span with real anchor when url present (D-09)
      const linksDiv = row.querySelector<HTMLElement>('.text-row__links');
      if (linksDiv && track.url) {
        const existingSpan = linksDiv.querySelector('.text-row__link--disabled');
        if (existingSpan) {
          const a = document.createElement('a');
          a.href = track.url;
          a.target = '_blank';
          a.rel = 'noopener noreferrer';
          a.className = 'text-row__link';
          a.setAttribute('aria-label', `Listen to ${track.name} by ${track.artist} on last.fm`);
          a.textContent = 'last.fm';
          existingSpan.replaceWith(a);
        }
      }

      // Set thumb src from raw CDN url (D-10) — tracks DO carry a thumbnail
      if (track.imageUrl) {
        const thumb = row.querySelector<HTMLImageElement>('.text-row__thumb');
        if (thumb) thumb.src = track.imageUrl;
      }
    }
  }

  // loadInitialListData — CRITICAL: must be a hoisted `function` declaration, never
  // `const loadInitialListData = () => {}`. activateView() runs synchronously near the top
  // of this script and calls this function on first activation of a view — long before this
  // declaration is reached in file source order. An arrow-function const would be `undefined`
  // at that first call and throw a ReferenceError/TypeError (see PATTERNS.md hoisting trap).
  //
  // Mirrors the shape of the albums initial-fill IIFE below, parameterized by view (D-02/D-03).
  // Albums keeps its shipped silent-fallback behavior unchanged (success criterion 4) — only
  // the artists/tracks branches surface the container's error block on failure, per the
  // UI-SPEC initial-load error-state contract, and remove the view from loadedViews so a
  // later re-activation can retry.
  function loadInitialListData(view: string): void {
    // WR-01: single-flight per view — concurrent invocations (double-clicked Retry,
    // re-activation during an in-flight retry) must not double-run the batch resolvers.
    if (initialLoadInFlight.has(view)) return;
    initialLoadInFlight.add(view);

    const listContainer = document.querySelector<HTMLElement>(`.chart-list[data-view="${view}"]`);
    const errorRegion = listContainer?.querySelector<HTMLElement>('.chart-list__error') ?? null;
    const errorMsg = listContainer?.querySelector<HTMLElement>('.chart-list__error-msg') ?? null;
    const loadMoreBtn = listContainer?.querySelector<HTMLButtonElement>('.chart-list__load-more') ?? null;
    const noun = view === 'artists' ? 'artists' : view === 'tracks' ? 'tracks' : 'albums';

    function showInitialLoadError(): void {
      loadedViews.delete(view); // allow a later re-activation of this view to retry
      initialLoadFailed.add(view); // WR-01: route the init-wired Retry to the initial fetch
      if (errorMsg) errorMsg.textContent = `Failed to load ${noun}.`;
      if (errorRegion) errorRegion.hidden = false;
      // WR-01: no addEventListener here — Retry is dispatched by the single listener wired
      // at init (see the container wiring loop below), so listeners never accumulate across
      // repeated failures and one click never fires loadInitialListData AND loadMoreChunk.
    }

    const controller = new AbortController();
    const timeoutId = setTimeout(() => controller.abort(), 10_000);

    (async () => {
      try {
        const res = await fetch(
          `/api/chart-list?view=${encodeURIComponent(view)}&offset=0&limit=20`,
          { signal: controller.signal }
        );
        clearTimeout(timeoutId);

        if (!res.ok) {
          if (view === 'albums') return; // shipped silent-fallback — skeleton rows remain
          showInitialLoadError();
          return;
        }

        if (view === 'artists') {
          const data = await res.json() as ChartListArtistResponse;
          fillArtistList('artists', data.rows);
          // Artist batch-resolve: thumb + fade-in + website link (REVL-08/09)
          const ol = document.querySelector<HTMLOListElement>('.chart-list[data-view="artists"] .text-list');
          if (ol) await appendArtistExtras(ol, data.rows);
          if (errorRegion) errorRegion.hidden = true;
          loadedViews.add(view); // WR-02: restore the D-04 no-refetch contract after a successful retry
          initialLoadFailed.delete(view); // WR-01: Retry routes back to loadMoreChunk from here on
          if (loadMoreBtn) loadMoreBtn.disabled = false; // WR-01: rows 1–20 exist — Load more is actionable
        } else if (view === 'tracks') {
          const data = await res.json() as ChartListTrackResponse;
          fillTrackList('tracks', data.rows);
          // Track batch-resolve: website link only, thumb already sourced from imageUrl (REVL-09)
          const ol = document.querySelector<HTMLOListElement>('.chart-list[data-view="tracks"] .text-list');
          if (ol) await appendTrackWebsiteLinks(ol, data.rows);
          if (errorRegion) errorRegion.hidden = true;
          loadedViews.add(view); // WR-02: restore the D-04 no-refetch contract after a successful retry
          initialLoadFailed.delete(view); // WR-01: Retry routes back to loadMoreChunk from here on
          if (loadMoreBtn) loadMoreBtn.disabled = false; // WR-01: rows 1–20 exist — Load more is actionable
        } else {
          const data = await res.json() as ChartListResponse;
          fillTextList('albums', data.rows);
          const ol = document.querySelector<HTMLOListElement>('.chart-list[data-view="albums"] .text-list');
          if (ol) await appendWebsiteLinks(ol, data.rows);
        }
      } catch (err) {
        clearTimeout(timeoutId);
        if (view === 'albums') {
          console.error('[chart] list fill failed:', err); // skeleton rows remain — silent fallback
          return;
        }
        console.error(`[chart] ${view} list fill failed:`, err);
        showInitialLoadError();
      } finally {
        // WR-01: release the single-flight guard on every exit path (success, early
        // return, failure) so a later Retry / re-activation can issue a fresh fetch.
        initialLoadInFlight.delete(view);
      }
    })();
  }

  (async () => {
    const controller = new AbortController();
    const timeoutId = setTimeout(() => controller.abort(), 10_000);
    try {
      const res = await fetch('/api/chart-data', { signal: controller.signal });
      clearTimeout(timeoutId);
      if (!res.ok) { fallbackAll(); return; }
      const data = await res.json() as ChartDataResponse;
      const artistMap: ArtistMap = new Map(data.artists.map(a => [a.name.toLowerCase(), a]));
      fillArtistGridTiles(artistMap);
    } catch (err) {
      clearTimeout(timeoutId);
      console.error('[chart] progressive fill failed:', err);
      fallbackAll();
    }
  })();

  // ---- Artist-website batch lookup (REVL-02) ----
  // Appends a '·' sep + website <a> to each rendered row whose artist has a cached
  // genuine external website (D-03: last.fm-host URLs already filtered server-side).
  // On fetch failure or non-ok response the website slot is silently omitted (graceful).
  // All DOM writes via createElement + textContent + setAttribute — no innerHTML (T-18-07).
  async function appendWebsiteLinks(
    ol: HTMLOListElement,
    rows: ChartListRow[]
  ): Promise<void> {
    if (rows.length === 0) return;

    // Collect unique artist names (preserving original casing for response matching)
    const uniqueArtists = [...new Set(rows.map(r => r.artist))];

    const controller = new AbortController();
    const timeoutId = setTimeout(() => controller.abort(), 10_000);
    let websites: Record<string, { websiteUrl: string | null; imageUrl: string | null }> = {};
    try {
      const res = await fetch('/api/artist-websites', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ artists: uniqueArtists }),
        signal: controller.signal,
      });
      clearTimeout(timeoutId);
      if (!res.ok) return; // graceful omit on non-ok (REVL-02)
      websites = await res.json() as Record<string, { websiteUrl: string | null; imageUrl: string | null }>;
    } catch {
      clearTimeout(timeoutId);
      return; // graceful omit on fetch error/timeout (REVL-02)
    }

    // Append website slot to each row whose artist maps to a non-null url
    const rowEls = Array.from(ol.querySelectorAll<HTMLLIElement>('.text-row'));
    for (const rowEl of rowEls) {
      // Find the corresponding album data by rank attribute or position
      const rankEl = rowEl.querySelector('.text-row__rank');
      if (!rankEl) continue;
      const rank = Number(rankEl.textContent);
      const album = rows.find(r => r.rank === rank);
      if (!album) continue;

      const websiteUrl = websites[album.artist]?.websiteUrl;
      if (!websiteUrl) continue; // null or undefined — no slot

      const linksDiv = rowEl.querySelector<HTMLElement>('.text-row__links');
      if (!linksDiv) continue;

      const sep = document.createElement('span');
      sep.className = 'text-row__sep';
      sep.setAttribute('aria-hidden', 'true');
      sep.textContent = '·';
      linksDiv.appendChild(sep);

      const webA = document.createElement('a');
      webA.href = websiteUrl;
      webA.target = '_blank';
      webA.rel = 'noopener noreferrer';
      webA.className = 'text-row__link';
      webA.setAttribute('aria-label', `${album.artist} website`);
      webA.textContent = 'website';
      linksDiv.appendChild(webA);
    }
  }

  // ---- Artist batch-resolve: thumb + fade-in + website link (REVL-08/09) ----
  // Sibling fork of appendWebsiteLinks for the artists view (D-03/D-04/D-05).
  // In addition to the conditional "· website" link, resolves each row's imageUrl:
  // sets thumb.src + data-image (Pitfall 4: always setAttribute, never removeAttribute)
  // and toggles the text-row__thumb--loaded fade-in class on the image's native load
  // event. Fails silently — a failed/timed-out batch resolve never blocks the already-
  // rendered rank/name/plays/last.fm content (distinct from D-07's surfaced initial-load
  // error, which is the /api/chart-list fetch, not this one). All DOM writes via property
  // assignment / setAttribute / textContent — no innerHTML (T-18-07).
  async function appendArtistExtras(
    ol: HTMLOListElement,
    rows: ChartListArtistRow[]
  ): Promise<void> {
    if (rows.length === 0) return;

    // Collect unique artist names (preserving original casing for response matching);
    // ChartListArtistRow has no .artist field — key by .name (D-03).
    const uniqueNames = [...new Set(rows.map(r => r.name))];

    const controller = new AbortController();
    const timeoutId = setTimeout(() => controller.abort(), 10_000);
    let extras: Record<string, { websiteUrl: string | null; imageUrl: string | null }> = {};
    try {
      const res = await fetch('/api/artist-websites', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ artists: uniqueNames }),
        signal: controller.signal,
      });
      clearTimeout(timeoutId);
      if (!res.ok) return; // graceful omit on non-ok
      extras = await res.json() as Record<string, { websiteUrl: string | null; imageUrl: string | null }>;
    } catch {
      clearTimeout(timeoutId);
      return; // graceful omit on fetch error/timeout
    }

    const rowEls = Array.from(ol.querySelectorAll<HTMLLIElement>('.text-row'));
    for (const rowEl of rowEls) {
      const rankEl = rowEl.querySelector('.text-row__rank');
      if (!rankEl) continue;
      const rank = Number(rankEl.textContent);
      const artist = rows.find(r => r.rank === rank);
      if (!artist) continue;

      const entry = extras[artist.name];

      // Thumb + data-image (D-01/D-02/D-04) — always setAttribute, never
      // removeAttribute (Pitfall 4); imageless artists keep data-image="" so the
      // reveal engine's existing D-02 gate continues hiding the overlay for them.
      rowEl.setAttribute('data-image', entry?.imageUrl ?? '');
      if (entry?.imageUrl) {
        const thumb = rowEl.querySelector<HTMLImageElement>('.text-row__thumb');
        // WR-01 idempotency: only set src on a still-empty reserved slot — a repeated
        // resolve must not re-assign src or stack duplicate load listeners.
        if (thumb && !thumb.getAttribute('src')) {
          thumb.src = entry.imageUrl;
          if (thumb.complete) {
            thumb.classList.add('text-row__thumb--loaded');
          } else {
            thumb.addEventListener('load', () => {
              thumb.classList.add('text-row__thumb--loaded');
            }, { once: true });
          }
        }
      }

      // Website link (D-05) — same disabled-span→anchor precedent as albums
      const websiteUrl = entry?.websiteUrl;
      if (!websiteUrl) continue; // null or undefined — no slot

      const linksDiv = rowEl.querySelector<HTMLElement>('.text-row__links');
      if (!linksDiv) continue;

      // WR-01 idempotency: never append a second "· website" pair to a row that
      // already carries one (defense-in-depth behind the single-flight guard).
      if (Array.from(linksDiv.querySelectorAll('a.text-row__link'))
        .some((a) => a.textContent === 'website')) continue;

      const sep = document.createElement('span');
      sep.className = 'text-row__sep';
      sep.setAttribute('aria-hidden', 'true');
      sep.textContent = '·';
      linksDiv.appendChild(sep);

      const webA = document.createElement('a');
      webA.href = websiteUrl;
      webA.target = '_blank';
      webA.rel = 'noopener noreferrer';
      webA.className = 'text-row__link';
      webA.setAttribute('aria-label', `${artist.name} website`);
      webA.textContent = 'website';
      linksDiv.appendChild(webA);
    }
  }

  // ---- Track batch-resolve: website link only (REVL-09) ----
  // Sibling fork of appendWebsiteLinks for the tracks view, keyed by track.artist.
  // Track rows' thumb/data-image already resolve synchronously from track.imageUrl
  // (Phase 22) — this helper consumes only .websiteUrl and never touches the thumb.
  // Fails silently, same graceful-omit contract as appendArtistExtras. All DOM writes
  // via createElement/textContent/setAttribute — no innerHTML (T-18-07).
  async function appendTrackWebsiteLinks(
    ol: HTMLOListElement,
    rows: ChartListTrackRow[]
  ): Promise<void> {
    if (rows.length === 0) return;

    const uniqueArtists = [...new Set(rows.map(r => r.artist))];

    const controller = new AbortController();
    const timeoutId = setTimeout(() => controller.abort(), 10_000);
    let websites: Record<string, { websiteUrl: string | null; imageUrl: string | null }> = {};
    try {
      const res = await fetch('/api/artist-websites', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ artists: uniqueArtists }),
        signal: controller.signal,
      });
      clearTimeout(timeoutId);
      if (!res.ok) return; // graceful omit on non-ok
      websites = await res.json() as Record<string, { websiteUrl: string | null; imageUrl: string | null }>;
    } catch {
      clearTimeout(timeoutId);
      return; // graceful omit on fetch error/timeout
    }

    const rowEls = Array.from(ol.querySelectorAll<HTMLLIElement>('.text-row'));
    for (const rowEl of rowEls) {
      const rankEl = rowEl.querySelector('.text-row__rank');
      if (!rankEl) continue;
      const rank = Number(rankEl.textContent);
      const track = rows.find(r => r.rank === rank);
      if (!track) continue;

      const websiteUrl = websites[track.artist]?.websiteUrl;
      if (!websiteUrl) continue; // null or undefined — no slot

      const linksDiv = rowEl.querySelector<HTMLElement>('.text-row__links');
      if (!linksDiv) continue;

      // WR-01 idempotency: never append a second "· website" pair to a row that
      // already carries one (defense-in-depth behind the single-flight guard).
      if (Array.from(linksDiv.querySelectorAll('a.text-row__link'))
        .some((a) => a.textContent === 'website')) continue;

      const sep = document.createElement('span');
      sep.className = 'text-row__sep';
      sep.setAttribute('aria-hidden', 'true');
      sep.textContent = '·';
      linksDiv.appendChild(sep);

      const webA = document.createElement('a');
      webA.href = websiteUrl;
      webA.target = '_blank';
      webA.rel = 'noopener noreferrer';
      webA.className = 'text-row__link';
      webA.setAttribute('aria-label', `${track.artist} website`);
      webA.textContent = 'website';
      linksDiv.appendChild(webA);

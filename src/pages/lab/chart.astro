---
// src/pages/lab/chart.astro
// SSR: fetches live data from Last.fm on every request.
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCachedTopAlbums, getCachedTopArtists, getCachedTopTracks } from '../../lib/lastfm-cache';
import type { Album, Artist, Track } from '../../lib/lastfm';
import { env } from 'cloudflare:workers';
const _env = env as unknown as { LASTFM_CHART_CACHE: KVNamespace };
const kv = _env.LASTFM_CHART_CACHE;
import { changelog } from '../../data/changelog';

const chartChangelog = changelog.filter((e) => e.project === 'chart');

function formatDate(iso: string): string {
  const [y, m, d] = iso.split('-');
  const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  if (!m) return y;
  if (!d) return `${months[Number(m) - 1]} ${y}`;
  return `${months[Number(m) - 1]} ${Number(d)}, ${y}`;
}

function formatPlays(n: number): string {
  if (n >= 999_950) return `${(n / 1_000_000).toFixed(1)}M`;
  if (n >= 1_000) return `${(n / 1_000).toFixed(1)}k`;
  return String(n);
}

function formatPlaysLong(n: number): string {
  return new Intl.NumberFormat('en-US').format(n);
}

let albums: Album[] = [];
let artists: Artist[] = [];
let tracks: Track[] = [];
let hasError = false;
let fetchedAt: number = Date.now();

try {
  const [albumsResult, artistsResult, tracksResult] = await Promise.all([
    getCachedTopAlbums(kv, env, 20),
    getCachedTopArtists(kv, env, 20, '7day'),
    getCachedTopTracks(kv, env, 20),
  ]);
  albums = albumsResult.data;
  artists = artistsResult.data;
  tracks = tracksResult.data;
  fetchedAt = albumsResult.fetchedAt;
} catch (err) {
  console.error('[lab/chart] data fetch failed:', err);
  hasError = true;
}

// Build artist → imageUrl lookup from top albums (first/highest-ranked album per artist wins)
const albumArtByArtist = new Map<string, string>();
for (const album of albums) {
  if (album.imageUrl && !albumArtByArtist.has(album.artist.toLowerCase())) {
    albumArtByArtist.set(album.artist.toLowerCase(), album.imageUrl);
  }
}

// Fill missing track thumbnails from album art
// Last.fm returns a placeholder for tracks with no art — treat it as empty
const LASTFM_PLACEHOLDER = '2a96cbd8b46e442fc41c2b86b821562f';
const tracksWithArt = tracks.map(track =>
  (track.imageUrl && !track.imageUrl.includes(LASTFM_PLACEHOLDER))
    ? track
    : { ...track, imageUrl: albumArtByArtist.get(track.artist.toLowerCase()) ?? '' }
);

const gridAlbums = albums.slice(0, 16);
const gridArtists = artists.slice(0, 16);
const gridTracks = tracksWithArt.slice(0, 16);

function formatRelativeAge(ts: number): string {
  const ageMs = Date.now() - ts;
  const ageSec = Math.floor(ageMs / 1000);
  const ageMin = Math.floor(ageSec / 60);

  if (ageSec < 60) return 'Updated just now';
  if (ageMin === 1) return 'Updated 1 min ago';
  if (ageMin < 60) return `Updated ${ageMin} min ago`;
  const ageHr = Math.floor(ageMin / 60);
  if (ageHr === 1) return 'Updated 1 hr ago';
  return `Updated ${ageHr} hr ago`;
}

const updatedAt = formatRelativeAge(fetchedAt);
const fetchedAtIso = new Date(fetchedAt).toISOString();
---

<BaseLayout title="Chart" description="A weekly chart of top albums from Last.fm, visualized with D3." ogTitle="Chart">
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400&family=DM+Sans:wght@400;600&display=swap" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=language,open_in_new&display=block"
    />
  </Fragment>
  <section class="chart container">
    <h1 class="chart__heading">chart.</h1>
    <p class="chart__intro">Weekly top albums from Last.fm.</p>
    <time class="chart__updated" datetime={fetchedAtIso}>{updatedAt}</time>

    {hasError ? (
      <p class="chart__error">Chart unavailable — check back soon.</p>
    ) : (
      <>
        <div class="chart__controls">
          <div class="chart__view-links">
            <a class="chart__view-link" data-for="albums" role="button" tabindex="0">albums</a>
            <span class="chart__view-sep">/</span>
            <a class="chart__view-link" data-for="artists" role="button" tabindex="0">artists</a>
            <span class="chart__view-sep">/</span>
            <a class="chart__view-link" data-for="tracks" role="button" tabindex="0">tracks</a>
          </div>
          <div class="chart__controls-right">
            <label class="chart__toggle">
              <input type="checkbox" class="chart__toggle-input" id="chart-labels-toggle" />
              <span class="chart__toggle-pill" aria-hidden="true"></span>
              <span class="chart__toggle-label">labels</span>
            </label>
            <button class="chart__copy-btn" type="button">copy chart</button>
          </div>
        </div>

        <div class="chart__view" data-view="albums">
          <div class="chart__body">
            <div class="chart__col-grid">
              <div class="chart__grid" aria-label={`Top ${gridAlbums.length} albums as grid`}>
                {gridAlbums.map((album) => (
                  <div class="chart__tile chart__shimmer">
                    {album.imageUrl ? (
                      <img
                        src={`/api/proxy-image?url=${encodeURIComponent(album.imageUrl)}`}
                        crossorigin="anonymous"
                        alt={`${album.name} by ${album.artist}`}
                        width="300"
                        height="300"
                        loading="lazy"
                      />
                    ) : (
                      <div class="chart__tile-placeholder chart__shimmer" aria-hidden="true"></div>
                    )}
                    <div class="chart__tile-overlay" aria-hidden="true">
                      <span class="chart__overlay-artist">{album.artist}</span>
                      <span class="chart__overlay-album">{album.name}</span>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>

        <div class="chart__view" data-view="artists" style="display:none">
          <div class="chart__body">
            <div class="chart__col-grid">
              <div class="chart__grid chart__grid--artists" aria-label={`Top ${gridArtists.length} artists as grid`}>
                {gridArtists.map((artist, i) => (
                  <div class="chart__tile chart__tile--artist" data-artist={artist.name}>
                    <div class="chart__tile-placeholder" aria-hidden="true"></div>
                    <span class="chart__artist-rank">{String(i + 1).padStart(2, '0')}</span>
                    <div class="chart__artist-info">
                      <span class="chart__artist-name">{artist.name}</span>
                      <span class="chart__artist-plays">{artist.playcount} plays</span>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>

        <div class="chart__view" data-view="tracks" style="display:none">
          <div class="chart__body">
            <div class="chart__col-grid">
              <div class="chart__grid" aria-label={`Top ${gridTracks.length} tracks as grid`}>
                {gridTracks.map((track) => (
                  <div class="chart__tile chart__shimmer">
                    {track.imageUrl ? (
                      <img
                        src={`/api/proxy-image?url=${encodeURIComponent(track.imageUrl)}`}
                        crossorigin="anonymous"
                        alt={`${track.name} by ${track.artist}`}
                        width="300"
                        height="300"
                        loading="lazy"
                      />
                    ) : (
                      <div class="chart__tile-placeholder chart__shimmer" aria-hidden="true"></div>
                    )}
                    <div class="chart__tile-overlay" aria-hidden="true">
                      <span class="chart__overlay-artist">{track.artist}</span>
                      <span class="chart__overlay-album">{track.name}</span>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </>
    )}
  </section>

  <section class="chart-list-section container">
    <div class="chart-list" data-view="albums">
      <h2 class="chart-list-section__heading">Weekly albums</h2>
      <ol class="text-list" role="list">
        {Array.from({ length: 20 }).map(() => (
          <li class="text-row" data-image="">
            <div class="text-row__primary">
              {/* Empty skeleton rank — JS sets textContent on load. No aria-label:
                  it's prohibited on a roleless empty span (axe aria-prohibited-attr). */}
              <span class="text-row__rank"></span>
              <span class="text-row__sep" aria-hidden="true">|</span>
              <span class="text-row__album"></span>
              <span class="text-row__sep" aria-hidden="true">—</span>
              <span class="text-row__artist"></span>
            </div>
            <div class="text-row__plays-group">
              <span class="text-row__plays-label">Plays</span>
              <span class="text-row__plays"></span>
            </div>
            <div class="text-row__links">
              <span class="text-row__link text-row__link--disabled" aria-hidden="true">last.fm</span>
            </div>
            <img class="text-row__thumb" alt="" width="48" height="48" />
          </li>
        ))}
      </ol>
      <div class="chart-list__controls">
        {/* WR-02: starts disabled — enabled by the albums initial-fill IIFE on success,
            mirroring the artists/tracks pattern. Otherwise a click during the pending
            initial fetch appends ranks 21–40, which fillTextList's surplus-skeleton
            removal then deletes while the offset has already advanced past them. */}
        <button class="chart-list__load-more" type="button" aria-label="Load more albums" disabled>Load more</button>
        <p class="chart-list__end-note" hidden>That's everything — you've reached the end of this week's chart.</p>
        <div class="chart-list__error" role="alert" hidden>
          <span class="chart-list__error-msg">Failed to load more albums.</span>
          <button class="chart-list__retry" type="button">Retry</button>
        </div>
      </div>
    </div>

    <div class="chart-list" data-view="artists" style="display:none">
      <h2 class="chart-list-section__heading">Weekly artists</h2>
      <ol class="text-list" role="list">
        {Array.from({ length: 20 }).map(() => (
          <li class="text-row" data-image="">
            <div class="text-row__primary">
              {/* Empty skeleton rank — JS sets textContent on load. No aria-label:
                  it's prohibited on a roleless empty span (axe aria-prohibited-attr). */}
              <span class="text-row__rank"></span>
              <span class="text-row__sep" aria-hidden="true">|</span>
              <span class="text-row__name"></span>
            </div>
            <div class="text-row__plays-group">
              <span class="text-row__plays-label">Plays</span>
              <span class="text-row__plays"></span>
            </div>
            <div class="text-row__links">
              <span class="text-row__link text-row__link--disabled" aria-hidden="true">last.fm</span>
            </div>
            <img class="text-row__thumb" alt="" width="48" height="48" />
          </li>
        ))}
      </ol>
      <div class="chart-list__controls">
        {/* WR-01: starts disabled — enabled by loadInitialListData on a successful initial
            fill, so Load more is never actionable while rows 1–20 don't exist yet. */}
        <button class="chart-list__load-more" type="button" aria-label="Load more artists" disabled>Load more</button>
        <p class="chart-list__end-note" hidden>That's everything — you've reached the end of this week's chart.</p>
        <div class="chart-list__error" role="alert" hidden>
          <span class="chart-list__error-msg">Failed to load more artists.</span>
          <button class="chart-list__retry" type="button">Retry</button>
        </div>
      </div>
    </div>

    <div class="chart-list" data-view="tracks" style="display:none">
      <h2 class="chart-list-section__heading">Weekly tracks</h2>
      <ol class="text-list" role="list">
        {Array.from({ length: 20 }).map(() => (
          <li class="text-row" data-image="">
            <div class="text-row__primary">
              {/* Empty skeleton rank — JS sets textContent on load. No aria-label:
                  it's prohibited on a roleless empty span (axe aria-prohibited-attr). */}
              <span class="text-row__rank"></span>
              <span class="text-row__sep" aria-hidden="true">|</span>
              <span class="text-row__track"></span>
              <span class="text-row__sep" aria-hidden="true">—</span>
              <span class="text-row__artist"></span>
            </div>
            <div class="text-row__plays-group">
              <span class="text-row__plays-label">Plays</span>
              <span class="text-row__plays"></span>
            </div>
            <div class="text-row__links">
              <span class="text-row__link text-row__link--disabled" aria-hidden="true">last.fm</span>
            </div>
            <img class="text-row__thumb" alt="" width="48" height="48" />
          </li>
        ))}
      </ol>
      <div class="chart-list__controls">
        {/* WR-01: starts disabled — enabled by loadInitialListData on a successful initial
            fill, so Load more is never actionable while rows 1–20 don't exist yet. */}
        <button class="chart-list__load-more" type="button" aria-label="Load more tracks" disabled>Load more</button>
        <p class="chart-list__end-note" hidden>That's everything — you've reached the end of this week's chart.</p>
        <div class="chart-list__error" role="alert" hidden>
          <span class="chart-list__error-msg">Failed to load more tracks.</span>
          <button class="chart-list__retry" type="button">Retry</button>
        </div>
      </div>
    </div>
  </section>

  {chartChangelog.length > 0 && (
    <section class="chart__changelog-section container">
      <details class="chart__changelog">
        <summary class="chart__changelog-summary">
          changelog
          <span class="chart__changelog-count">{chartChangelog.length} {chartChangelog.length === 1 ? 'update' : 'updates'}</span>
          <span class="chart__changelog-arrow" aria-hidden="true">▸</span>
        </summary>
        <ol class="chart__changelog-list">
          {chartChangelog.map((entry) => (
            <li class="chart__changelog-entry">
              <time class="chart__changelog-date" datetime={entry.date}>
                {formatDate(entry.date)}
              </time>
              <ul class="chart__changelog-items">
                {entry.items.map((item) => (
                  <li class="chart__changelog-item">
                    <span class={`chart__changelog-label chart__changelog-label--${item.label}`}>
                      {item.label}
                    </span>
                    {item.text}
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ol>
      </details>
    </section>
  )}

  <dialog id="chart-copy-modal" class="chart__copy-modal" aria-label="Chart preview">
    <button class="chart__copy-modal-close" aria-label="Close preview" type="button">×</button>
    <img class="chart__copy-modal-img" alt="rendered chart, long-press to save" />
    <p class="chart__copy-modal-hint">long-press to save</p>
  </dialog>
</BaseLayout>

<style>
  .chart {
    padding-top: var(--space-2xl);
    padding-bottom: var(--space-xl);
  }

  .chart__heading {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-display-large);
    line-height: var(--lh-display-large);
    margin-bottom: var(--space-md);
  }

  .chart__intro {
    font-family: var(--font-body);
    font-size: var(--text-body-large);
    color: var(--color-on-surface-dimmed);
    line-height: var(--lh-body-large);
    margin-bottom: var(--space-xs);
  }

  .chart__error {
    font-family: var(--font-body);
    font-size: var(--text-body-large);
    color: var(--color-on-surface-dimmed);
    padding: var(--space-lg) 0;
  }

  .chart__updated {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.02em;
    color: var(--color-on-surface-muted);
    margin-bottom: var(--space-lg);
  }

  /* ---- Controls bar ---- */
  .chart__controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-xs);
  }

  .chart__view-links {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .chart__view-link {
    font-family: var(--font-body);
    font-size: var(--text-body-medium);
    color: var(--color-on-surface-muted);
    cursor: pointer;
    padding: 2px 0;
    font-weight: 500;
    text-decoration: none;
    user-select: none;
  }

  .chart__view-link--active {
    color: var(--color-on-surface);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .chart__view-sep {
    font-family: var(--font-body);
    font-size: var(--text-body-medium);
    color: var(--color-border);
  }

  .chart__controls-right {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .chart__toggle {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    cursor: pointer;
    user-select: none;
  }

  .chart__toggle-input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .chart__toggle-pill {
    width: 32px;
    height: 18px;
    background: var(--color-border);
    border-radius: 99px;
    position: relative;
    flex-shrink: 0;
    transition: background 0.15s;
  }

  .chart__toggle-pill::after {
    content: '';
    position: absolute;
    left: 3px;
    top: 3px;
    width: 12px;
    height: 12px;
    background: var(--color-on-surface);
    border-radius: 50%;
    transition: transform 0.15s;
  }

  .chart__toggle-input:checked ~ .chart__toggle-pill {
    background: var(--color-on-surface);
  }

  .chart__toggle-input:checked ~ .chart__toggle-pill::after {
    transform: translateX(14px);
  }

  .chart__toggle-label {
    font-family: var(--font-body);
    font-size: var(--text-body-medium);
    color: var(--color-on-surface-dimmed);
  }

  .chart__copy-btn {
    font-family: var(--font-body);
    font-size: var(--text-body-medium);
    color: var(--color-on-surface-dimmed);
    background: none;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: 4px 12px;
    cursor: pointer;
    letter-spacing: 0.01em;
  }

  .chart__copy-btn:hover {
    color: var(--color-on-surface);
    border-color: var(--color-on-surface-dimmed);
  }

  /* ---- 2x2 grid base (mobile-first) ---- */
  .chart__grid {
    --chart-grid-gap: 5px; /* chart-local thin seam — D-05/D-06; does not touch global --grid-gap */
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--chart-grid-gap);
    margin-bottom: var(--space-xl);
  }

  .chart__tile {
    position: relative;
    aspect-ratio: 1 / 1;
    background-color: var(--color-surface-subtle);
    overflow: hidden;
  }

  .chart__tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .chart__tile-placeholder {
    width: 100%;
    height: 100%;
    background-color: var(--color-surface-subtle);
  }

  /* ---- Tile overlay ---- */
  .chart__tile-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 18px 8px 7px;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.72) 0%, transparent 100%);
    opacity: 0;
    transform: translateY(4px);
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .chart__grid--labels .chart__tile-overlay {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .chart__overlay-artist {
    display: block;
    font-family: 'DM Sans', sans-serif;
    font-size: 10px;
    font-weight: 600;
    color: #fff;
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .chart__overlay-album {
    display: block;
    font-family: 'DM Sans', sans-serif;
    font-size: 9px;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.75);
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .chart__col-rank {
    width: 3ch;
    color: var(--color-on-surface-muted);
    font-variant-numeric: tabular-nums;
  }

  .chart__col-art {
    width: 56px;
    padding-right: 0;
  }

  .chart__thumb-wrap {
    width: 40px;
    height: 40px;
    overflow: hidden;
    flex-shrink: 0;
    background-color: var(--color-surface-subtle);
  }

  .chart__thumb-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .chart__thumb-placeholder {
    width: 40px;
    height: 40px;
    background-color: var(--color-surface-subtle);
  }

  .chart__col-plays {
    text-align: right;
    font-variant-numeric: tabular-nums;
    color: var(--color-on-surface-dimmed);
  }

  /* ---- Artist tiles ---- */
  .chart__tile--artist {
    position: relative;
    background-color: var(--color-surface-subtle);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 8px;
    cursor: default;
    text-decoration: none;
  }

  a.chart__tile--artist[href] {
    cursor: pointer;
  }

  .chart__tile--artist.has-photo {
    background-size: cover;
    background-position: center top;
    overflow: hidden;
  }

  .chart__tile--artist.has-photo::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.72) 0%, rgba(0, 0, 0, 0.1) 60%, transparent 100%);
    pointer-events: none;
  }

  .chart__tile--artist.has-photo .chart__artist-rank {
    color: rgba(255, 255, 255, 0.5);
  }

  .chart__tile--artist.has-photo .chart__artist-name {
    color: #fff;
  }

  .chart__tile--artist.has-photo .chart__artist-plays {
    color: rgba(255, 255, 255, 0.6);
  }

  .chart__artist-rank {
    position: absolute;
    top: 6px;
    left: 8px;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-on-surface-muted);
    line-height: 1;
  }

  .chart__artist-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .chart__artist-name {
    font-family: 'DM Sans', sans-serif;
    font-size: 9px;
    font-weight: 600;
    color: var(--color-on-surface-dimmed);
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .chart__artist-plays {
    font-family: var(--font-mono);
    font-size: 8px;
    color: var(--color-on-surface-muted);
    line-height: 1;
  }

  .chart__tile--artist.has-photo .chart__artist-rank {
    z-index: 2;
  }

  .chart__tile--artist.has-photo .chart__artist-info {
    position: relative;
    z-index: 2;
  }

  /* ---- Responsive: expand to 4 columns at wider viewports ---- */
  @media (min-width: 600px) {
    .chart__grid {

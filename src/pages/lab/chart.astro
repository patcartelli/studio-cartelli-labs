  }

  // Initial 20 list rows fill from the lightweight /api/chart-list endpoint
  // (revised D-05): independent of the slow enriched /api/chart-data path, so the
  // list shows live data without blocking on cold MusicBrainz/glow enrichment. The
  // list never reads enriched fields, and Load-more (Plan 18-04) uses the same source.
  (async () => {
    const controller = new AbortController();
    const timeoutId = setTimeout(() => controller.abort(), 10_000);
    try {
      const res = await fetch('/api/chart-list?view=albums&offset=0&limit=20', { signal: controller.signal });
      clearTimeout(timeoutId);
      if (!res.ok) return; // skeleton rows remain (acceptable this phase)
      const data = await res.json() as ChartListResponse;
      fillTextList('albums', data.rows);
      // WR-02: rows 1–20 now exist and the surplus-skeleton removal has run — Load more
      // can no longer interleave with the initial fill, so it becomes actionable here
      // (mirrors loadInitialListData's artists/tracks success paths).
      const albumsLoadMoreBtn = document.querySelector<HTMLButtonElement>(
        '.chart-list[data-view="albums"] .chart-list__load-more'
      );
      if (albumsLoadMoreBtn) albumsLoadMoreBtn.disabled = false;
      // Wire website links after rows are filled — single batch POST per fill (REVL-02)
      const ol = document.querySelector<HTMLOListElement>('.chart-list[data-view="albums"] .text-list');
      if (ol) await appendWebsiteLinks(ol, data.rows);
    } catch (err) {
      clearTimeout(timeoutId);
      console.error('[chart] list fill failed:', err); // skeleton rows remain
    }
  })();

  // ---- Load-more pagination ----
  // Keyed by activeViewName (D-12) so artists/tracks become data-wiring later.
  // Initial 20 rows already filled by the IIFE above — offset starts at 20.
  // T-18-09: all row text set via textContent; data-image via setAttribute (no innerHTML).
  // T-18-10: one chunk per click (user-driven); AbortController 10s timeout per request.
  // T-18-11: retry refetches the SAME offset on explicit user action; no auto-retry.

  // Per-view offset state (only albums wired this phase; artists/tracks deferred D-12)
  const listOffsets: Record<string, number> = { albums: 20, artists: 20, tracks: 20 };
  let loadMoreInFlight = false;

  // View-accurate error copy noun for loadMoreChunk (Pitfall 1 fix) — "Failed to load more
  // albums" was previously hardcoded, which was wrong on the artists/tracks views.
  const VIEW_NOUN: Record<string, string> = { albums: 'albums', artists: 'artists', tracks: 'tracks' };

  function createTextRow(album: ChartListRow): HTMLLIElement {
    const li = document.createElement('li');
    li.className = 'text-row';
    // T-18-09: data-image via setAttribute, not innerHTML
    li.setAttribute('data-image', album.imageUrl ?? '');


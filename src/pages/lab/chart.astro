    primary.className = 'text-row__primary';

    const rankSpan = document.createElement('span');
    rankSpan.className = 'text-row__rank';
    rankSpan.textContent = String(album.rank); // full unpadded rank (D-14, T-18-09)
    primary.appendChild(rankSpan);

    const sep1 = document.createElement('span');
    sep1.className = 'text-row__sep';
    sep1.setAttribute('aria-hidden', 'true');
    sep1.textContent = '|';

# Licensed fonts: the main studiocartelli.com site self-hosts a paid,
# non-redistributable commercial font family. Never commit font binaries
# to this public repo — see src/styles/global.css for the fallback stack
# this repo uses instead (labs-split Phase 1, D-03).
public/fonts/*.woff
public/fonts/*.woff2
public/fonts/*.otf
public/fonts/*.ttf
